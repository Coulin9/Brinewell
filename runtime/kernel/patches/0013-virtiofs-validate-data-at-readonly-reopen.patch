From: brinewell <brinewell@localhost>
Subject: [PATCH] virtiofs: validate cached pages at read-only reopen

On the Brinewell share, request a content generation in the unused
(non-passthrough) final word of OPEN. A host without this extension leaves
the reply bit clear. Remember a generation only after successful page
invalidation. Serialize generation comparisons and keep the normal
invalidation path for dirty/writable mappings and unsupported hosts.

--- a/fs/fuse/fuse_i.h
+++ b/fs/fuse/fuse_i.h
@@ -215,6 +215,9 @@
 	 */
 	struct mutex mutex;
 
+	/** @data_generation: Last validated Brinewell page cache generation. */
+	u32 data_generation;
+
 	/** @lock: Lock to protect write-related fields */
 	spinlock_t lock;
 
@@ -287,6 +290,7 @@
 
 	/** @open_flags: FOPEN_* flags returned by open */
 	u32 open_flags;
+	u32 data_generation;
 
 	/** @write_entry: Entry on inode's write_files list */
 	struct list_head write_entry;
--- a/fs/fuse/inode.c
+++ b/fs/fuse/inode.c
@@ -95,6 +95,7 @@
 
 	fi->inval_mask = ~0;
 	mutex_init(&fi->mutex);
+	fi->data_generation = 0;
 	spin_lock_init(&fi->lock);
 	fi->forget = fuse_alloc_forget();
 	if (!fi->forget)
--- a/fs/fuse/file.c
+++ b/fs/fuse/file.c
@@ -22,6 +22,9 @@
 #include <linux/task_io_accounting_ops.h>
 #include <linux/iomap.h>
 
+/* Private to the brinewell-share transport, echoed by a supporting host. */
+#define BRINEWELL_OPEN_DATA_GENERATION (1U << 31)
+
 static int fuse_send_open(struct fuse_mount *fm, u64 nodeid,
 			  unsigned int open_flags, int opcode,
 			  struct fuse_open_out *outargp)
@@ -38,6 +41,11 @@
 	    (inarg.flags & O_TRUNC) && !capable(CAP_FSETID)) {
 		inarg.open_flags |= FUSE_OPEN_KILL_SUIDGID;
 	}
+
+	if (fm->fc->brinewell_share && opcode == FUSE_OPEN &&
+	    !(open_flags & (O_ACCMODE | O_TRUNC | O_DIRECT)) &&
+	    !fm->fc->writeback_cache)
+		inarg.open_flags |= BRINEWELL_OPEN_DATA_GENERATION;
 
 	args.opcode = opcode;
 	args.nodeid = nodeid;
@@ -163,6 +171,13 @@
 		if (!err) {
 			ff->fh = outargp->fh;
 			ff->open_flags = outargp->open_flags;
+			if (fc->brinewell_share && !isdir &&
+			    (ff->open_flags & BRINEWELL_OPEN_DATA_GENERATION) &&
+			    !(ff->open_flags & FOPEN_PASSTHROUGH)) {
+				ff->data_generation = (u32)outargp->backing_id;
+				outargp->backing_id = 0;
+				ff->open_flags &= ~BRINEWELL_OPEN_DATA_GENERATION;
+			}
 		} else if (err != -ENOSYS) {
 			fuse_file_free(ff);
 			return ERR_PTR(err);
@@ -247,6 +262,30 @@
 	fuse_invalidate_attr_mask(inode, FUSE_STATX_MODSIZE);
 }
 
+static void fuse_revalidate_open_pages(struct inode *inode, struct fuse_file *ff)
+{
+	struct address_space *mapping = inode->i_mapping;
+	struct fuse_inode *fi = get_fuse_inode(inode);
+	u32 generation = ff->data_generation;
+
+	if (!ff->fm->fc->brinewell_share || FUSE_IS_DAX(inode)) {
+		invalidate_inode_pages2(mapping);
+		return;
+	}
+
+	mutex_lock(&fi->mutex);
+	if (inode_is_open_for_write(inode) || mapping_writably_mapped(mapping) ||
+	    mapping_tagged(mapping, PAGECACHE_TAG_DIRTY) ||
+	    mapping_tagged(mapping, PAGECACHE_TAG_WRITEBACK))
+		generation = 0;
+	if (!generation || fi->data_generation != generation) {
+		fi->data_generation = 0;
+		if (!invalidate_inode_pages2(mapping))
+			fi->data_generation = generation;
+	}
+	mutex_unlock(&fi->mutex);
+}
+
 static int fuse_open(struct inode *inode, struct file *file)
 {
 	struct fuse_mount *fm = get_fuse_mount(inode);
@@ -294,7 +333,7 @@
 		if (is_truncate)
 			truncate_pagecache(inode, 0);
 		else if (!(ff->open_flags & FOPEN_KEEP_CACHE))
-			invalidate_inode_pages2(inode->i_mapping);
+			fuse_revalidate_open_pages(inode, ff);
 	}
 out_unlock:
 	if (dax_truncate)
