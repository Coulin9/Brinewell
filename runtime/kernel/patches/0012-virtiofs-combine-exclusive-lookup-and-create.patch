From: brinewell <brinewell@localhost>
Subject: [PATCH] virtiofs: use atomic exclusive create on the Brinewell share

The host's CREATE uses open(O_CREAT | O_EXCL). For a fresh exclusive
lookup the host can report EEXIST or create the file in a single request.
Publish a new parallel-lookup dentry only after the host succeeds. Keep
the ordinary lookup and mknod fallback for servers without CREATE.

--- a/fs/fuse/fuse_i.h
+++ b/fs/fuse/fuse_i.h
@@ -585,6 +585,9 @@
 	/** @no_access: Is access not implemented by fs? */
 	unsigned no_access:1;
 
+	/** @brinewell_share: Brinewell host shared folder. */
+	unsigned brinewell_share:1;
+
 	/** @no_create: Is create not implemented by fs? */
 	unsigned no_create:1;
 
--- a/fs/fuse/virtio_fs.c
+++ b/fs/fuse/virtio_fs.c
@@ -1602,6 +1602,7 @@
 		}
 		ctx->dax_dev = fs->dax_dev;
 	}
+	fc->brinewell_share = !strcmp(fs->tag, "brinewell-share");
 	err = fuse_fill_super_common(sb, ctx);
 	if (err < 0)
 		goto err_free_fuse_devs;
--- a/fs/fuse/dir.c
+++ b/fs/fuse/dir.c
@@ -906,7 +906,10 @@
 		goto out_err;
 	}
 	kfree(forget);
-	d_instantiate(entry, inode);
+	if (d_in_lookup(entry))
+		d_add(entry, inode);
+	else
+		d_instantiate(entry, inode);
 	fuse_dentry_set_epoch(entry, epoch);
 	fuse_change_entry_timeout(entry, &outentry);
 	fuse_dir_changed(dir);
@@ -948,7 +951,19 @@
 		return -EIO;
 
 	if (d_in_lookup(entry)) {
-		struct dentry *res = fuse_lookup(dir, entry, 0);
+		struct dentry *res;
+
+		if (fc->brinewell_share && !fc->no_create &&
+		    (flags & (O_CREAT | O_EXCL | O_DIRECTORY)) == (O_CREAT | O_EXCL)) {
+			file->f_mode |= FMODE_CREATED;
+			err = fuse_create_open(idmap, dir, entry, file, flags, mode, FUSE_CREATE);
+			if (err != -ENOSYS)
+				return err;
+			fc->no_create = 1;
+			file->f_mode &= ~FMODE_CREATED;
+		}
+
+		res = fuse_lookup(dir, entry, 0);
 		if (res || d_really_is_positive(entry))
 			return finish_no_open(file, res);
 	}
