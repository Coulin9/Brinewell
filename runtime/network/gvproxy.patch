diff --git a/cmd/gvproxy/config.go b/cmd/gvproxy/config.go
index 710edc2..b13b0c8 100644
--- a/cmd/gvproxy/config.go
+++ b/cmd/gvproxy/config.go
@@ -1,6 +1,8 @@
 package main
 
 import (
+	network "brinewell/network"
+	"encoding/json"
 	"errors"
 	"flag"
 	"fmt"
@@ -27,6 +29,7 @@ const (
 
 type GvproxyArgs struct {
 	config             string
+	outboundConfig     string
 	endpoints          arrayFlags
 	debug              bool
 	mtu                int
@@ -108,11 +111,32 @@ func GvproxyInit() (*GvproxyConfig, error) {
 		}
 	}
 
-	// Pass it to the testable function
-	return GvproxyConfigure(&config, &args, version.String())
+	// Configure the virtual stack before opening any network listeners.
+	configured, err := GvproxyConfigure(&config, &args, version.String())
+	if err != nil {
+		return nil, err
+	}
+	if args.outboundConfig != "" {
+		data, err := os.ReadFile(args.outboundConfig)
+		if err != nil {
+			return nil, fmt.Errorf("read outbound configuration: %w", err)
+		}
+		var outbound network.Config
+		if err := json.Unmarshal(data, &outbound); err != nil {
+			return nil, errors.New("invalid outbound configuration JSON")
+		}
+		dialer, err := network.New(outbound)
+		if err != nil {
+			return nil, fmt.Errorf("outbound configuration: %w", err)
+		}
+		configured.Stack.DialContext = dialer.DialContext
+		configured.Stack.Resolver = dialer.Resolver()
+	}
+	return configured, nil
 }
 
 func GvproxyArgParse(flagSet *flag.FlagSet, args *GvproxyArgs, argv []string) (*GvproxyArgs, error) {
+	flagSet.StringVar(&args.outboundConfig, "outbound-config", "", "Brinewell outbound network configuration file")
 	flagSet.StringVar(&args.config, "config", "", "Use configuration file with command line override")
 	flagSet.Var(&args.endpoints, "listen", "control endpoint")
 	flagSet.BoolVar(&args.debug, "debug", false, "Print debug info")
