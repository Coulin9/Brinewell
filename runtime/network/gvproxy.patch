--- a/pkg/services/forwarder/brinewell_security_test.go
+++ b/pkg/services/forwarder/brinewell_security_test.go
@@ -0,0 +1,50 @@
+package forwarder
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/containers/gvisor-tap-vsock/pkg/types"
+)
+
+func TestBrinewellForwarderAPI(t *testing.T) {
+	f := NewPortsForwarder(nil)
+	mux := f.Mux()
+	post := func(path, body string) int {
+		w := httptest.NewRecorder()
+		mux.ServeHTTP(w, httptest.NewRequest(http.MethodPost, path, strings.NewReader(body)))
+		return w.Code
+	}
+	for _, body := range []string{
+		`{"protocol":"unix","local":"/tmp/socket","remote":"tcp://192.168.127.2:22"}`,
+		`{"protocol":"npipe","local":"127.0.0.1:1234","remote":"192.168.127.2:22"}`,
+		`{"protocol":"udp","local":"127.0.0.1:1234","remote":"192.168.127.2:22"}`,
+		`{"local":"0.0.0.0:1234","remote":"192.168.127.2:22"}`,
+		`{"local":"127.0.0.1:0","remote":"192.168.127.2:22"}`,
+		`{"local":"127.0.0.1:65536","remote":"192.168.127.2:22"}`,
+		`{"local":"/tmp/socket","remote":"192.168.127.2:22"}`,
+		`{"local":"127.0.0.1:1234","remote":"192.168.127.2:23"}`,
+	} {
+		if got := post("/expose", body); got != http.StatusBadRequest {
+			t.Errorf("expose %s: got %d", body, got)
+		}
+	}
+	closed := false
+	local := "127.0.0.1:1234"
+	f.proxies[key(types.TCP, local)] = proxy{Remote: "192.168.127.2:22", underlying: CloseWrapper(func() error { closed = true; return nil })}
+	for _, protocol := range []string{"unix", "npipe", "udp"} {
+		body := fmt.Sprintf(`{"local":%q,"protocol":%q}`, local, protocol)
+		if got := post("/unexpose", body); got != http.StatusBadRequest {
+			t.Errorf("unexpose %s: got %d", body, got)
+		}
+	}
+	if got := post("/unexpose", `{"local":"127.0.0.1:1234","remote":"192.168.127.2:23"}`); got != http.StatusConflict || closed {
+		t.Fatalf("mismatch: status %d, closed %v", got, closed)
+	}
+	if got := post("/unexpose", `{"local":"127.0.0.1:1234","remote":"192.168.127.2:22"}`); got != http.StatusOK || !closed {
+		t.Fatalf("matching remote: status %d, closed %v", got, closed)
+	}
+}
