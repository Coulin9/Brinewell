diff --git a/src/kosmickrisp/vulkan/kk_nir_geometry.c b/src/kosmickrisp/vulkan/kk_nir_geometry.c
new file mode 100644
index 0000000..131b23e
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_nir_geometry.c
@@ -0,0 +1,268 @@
+/* SPDX-License-Identifier: MIT */
+
+#include "poly/nir/poly_nir.h"
+#include "kk_shader.h"
+#include "nir_builder.h"
+
+/* Compute runs the application GS exactly once per primitive and invocation.
+ * Keep emitted vertices in primitive order even when GPU threads finish out
+ * of order. A small vertex shader fetches the captured varyings for Metal. */
+struct capture_output {
+   nir_variable *value;
+   nir_io_semantics io;
+   nir_alu_type type;
+   unsigned offset;
+};
+
+struct geometry_lowering {
+   struct kk_geometry_info *info;
+   struct capture_output outputs[NUM_TOTAL_VARYING_SLOTS][4][2];
+   nir_variable *index_count;
+   nir_def *gid, *vertex_base, *index_base, *vertices, *last, *rasterize;
+   unsigned width;
+};
+
+static nir_def *
+param(nir_builder *b, unsigned offset, unsigned bits)
+{
+   nir_def *addr =
+      nir_iadd_imm(b, nir_load_geometry_param_buffer_poly(b), offset);
+   return nir_load_global_constant(b, 1, bits, addr, .align_mul = 4);
+}
+
+#define PARAM(b, field, bits)                                                  \
+   param(b, offsetof(struct kk_geometry_params, field), bits)
+
+static nir_def *
+element(nir_builder *b, nir_def *base, nir_def *idx, unsigned stride)
+{
+   return nir_iadd(b, base, nir_imul_imm(b, nir_u2u64(b, idx), stride));
+}
+
+static struct capture_output *
+output_at(struct geometry_lowering *s, nir_intrinsic_instr *i)
+{
+   nir_io_semantics io = nir_intrinsic_io_semantics(i);
+   unsigned loc = io.location + nir_src_as_uint(i->src[1]);
+   return &s->outputs[loc][nir_intrinsic_component(i)][io.high_16bits];
+}
+
+static bool
+gather(nir_builder *b, nir_intrinsic_instr *i, void *data)
+{
+   struct geometry_lowering *s = data;
+   if (i->intrinsic == nir_intrinsic_emit_vertex) {
+      /* Straight-line EmitVertex sites give a tighter allocation bound than
+       * OutputVertices. A remaining loop can execute up to the declared cap. */
+      unsigned limit = b->shader->info.gs.vertices_out;
+      for (nir_cf_node *node = i->instr.block->cf_node.parent; node;
+           node = node->parent) {
+         if (node->type == nir_cf_node_loop) {
+            s->info->vertices_out = limit;
+            return false;
+         }
+      }
+      s->info->vertices_out = MIN2(s->info->vertices_out + 1, limit);
+      return false;
+   }
+   if (i->intrinsic != nir_intrinsic_store_output)
+      return false;
+
+   struct capture_output *o = output_at(s, i);
+   if (!o->value) {
+      o->type = nir_intrinsic_src_type(i);
+      o->io = nir_intrinsic_io_semantics(i);
+      o->io.location += nir_src_as_uint(i->src[1]);
+      o->io.num_slots = 1;
+      o->offset = s->info->vertex_stride;
+      s->info->vertex_stride += sizeof(uint32_t);
+      o->value = nir_local_variable_create(b->impl, glsl_uint_type(), "gs_out");
+   }
+   return false;
+}
+
+static void
+emit(nir_builder *b, struct geometry_lowering *s, nir_def *ordinal,
+     nir_def *strip_vertex)
+{
+   if (s->info->max_indices == 0)
+      return;
+
+   nir_push_if(b, s->rasterize);
+   nir_def *idx = nir_iadd(b, s->vertex_base, ordinal);
+   nir_def *dst = element(b, s->vertices, idx, s->info->vertex_stride);
+
+   for (unsigned l = 0; l < ARRAY_SIZE(s->outputs); ++l) {
+      for (unsigned c = 0; c < 4; ++c) {
+         for (unsigned h = 0; h < 2; ++h) {
+            struct capture_output *o = &s->outputs[l][c][h];
+            if (o->value)
+               nir_store_global(b, nir_load_var(b, o->value),
+                                nir_iadd_imm(b, dst, o->offset),
+                                .align_mul = 4);
+         }
+      }
+   }
+
+   if (s->width > 1)
+      nir_push_if(b, nir_uge_imm(b, strip_vertex, s->width - 1));
+   nir_def *first = nir_iadd_imm(b, idx, 1 - (int)s->width);
+   nir_def *ids[3] = {first};
+   if (s->width == 2) {
+      ids[0] = nir_bcsel(b, s->last, idx, first);
+      ids[1] = nir_bcsel(b, s->last, first, idx);
+   } else if (s->width == 3) {
+      nir_def *odd = nir_ine_imm(b, nir_iand_imm(b, strip_vertex, 1), 0);
+      nir_def *mid = nir_iadd_imm(b, first, 1);
+      ids[0] = nir_bcsel(b, s->last, idx, first);
+      ids[1] = nir_bcsel(b, s->last, nir_bcsel(b, odd, mid, first),
+                         nir_bcsel(b, odd, idx, mid));
+      ids[2] = nir_bcsel(b, s->last, nir_bcsel(b, odd, first, mid),
+                         nir_bcsel(b, odd, mid, idx));
+   }
+   nir_def *count = nir_load_var(b, s->index_count);
+   nir_store_global(b, nir_vec(b, ids, s->width),
+                    element(b, s->index_base, count, 4), .align_mul = 4);
+   nir_store_var(b, s->index_count, nir_iadd_imm(b, count, s->width), 1);
+   if (s->width > 1)
+      nir_pop_if(b, NULL);
+   nir_pop_if(b, NULL);
+}
+
+static bool
+lower(nir_builder *b, nir_intrinsic_instr *i, void *data)
+{
+   struct geometry_lowering *s = data;
+   b->cursor = nir_before_instr(&i->instr);
+
+   switch (i->intrinsic) {
+   case nir_intrinsic_load_primitive_id:
+   case nir_intrinsic_load_instance_id:
+   case nir_intrinsic_load_invocation_id: {
+      unsigned axis = i->intrinsic == nir_intrinsic_load_primitive_id  ? 0
+                      : i->intrinsic == nir_intrinsic_load_instance_id ? 1
+                                                                       : 2;
+      nir_def_replace(&i->def, nir_channel(b, s->gid, axis));
+      return true;
+   }
+   case nir_intrinsic_load_input_topology_poly:
+      nir_def_replace(&i->def, PARAM(b, geometry.input_topology, 32));
+      return true;
+   case nir_intrinsic_load_provoking_last:
+      nir_def_replace(&i->def, nir_b2iN(b, s->last, i->def.bit_size));
+      return true;
+   case nir_intrinsic_store_output: {
+      struct capture_output *o = output_at(s, i);
+      nir_store_var(b, o->value, nir_u2u32(b, i->src[0].ssa), 1);
+      break;
+   }
+   case nir_intrinsic_emit_vertex_with_counter:
+      emit(b, s, i->src[0].ssa, i->src[1].ssa);
+      break;
+   case nir_intrinsic_end_primitive_with_counter:
+      break;
+   case nir_intrinsic_set_vertex_and_primitive_count:
+      /* Pad unused list entries with vertex zero, which lies outside the
+       * clip volume. Constant-output shaders fold the loop away. */
+      if (nir_intrinsic_stream_id(i) == 0 && s->info->max_indices) {
+         nir_push_if(b, s->rasterize);
+         nir_push_loop(b);
+         nir_def *count = nir_load_var(b, s->index_count);
+         nir_break_if(b, nir_uge_imm(b, count, s->info->max_indices));
+         nir_store_global(b, nir_imm_int(b, 0),
+                          element(b, s->index_base, count, 4), .align_mul = 4);
+         nir_store_var(b, s->index_count, nir_iadd_imm(b, count, 1), 1);
+         nir_pop_loop(b, NULL);
+         nir_pop_if(b, NULL);
+      }
+      break;
+   default:
+      return false;
+   }
+
+   nir_instr_remove(&i->instr);
+   return true;
+}
+
+static nir_shader *
+raster_vertex(const nir_shader *gs, const struct geometry_lowering *s)
+{
+   nir_builder b = nir_builder_init_simple_shader(
+      MESA_SHADER_VERTEX, gs->options, "geometry_raster");
+   nir_def *id = nir_load_vertex_id(&b);
+   nir_def *addr =
+      element(&b, PARAM(&b, vertex_buffer, 64), id, s->info->vertex_stride);
+   b.shader->info.clip_distance_array_size = gs->info.clip_distance_array_size;
+   b.shader->info.cull_distance_array_size = gs->info.cull_distance_array_size;
+   for (unsigned l = 0; l < ARRAY_SIZE(s->outputs); ++l) {
+      for (unsigned c = 0; c < 4; ++c) {
+         for (unsigned h = 0; h < 2; ++h) {
+            const struct capture_output *o = &s->outputs[l][c][h];
+            if (!o->value)
+               continue;
+            nir_def *v = nir_load_global_constant(
+               &b, 1, 32, nir_iadd_imm(&b, addr, o->offset), .align_mul = 4);
+            if (l == VARYING_SLOT_POS)
+               v = nir_bcsel(&b, nir_ieq_imm(&b, id, 0),
+                             nir_imm_float(&b, c == 0   ? 2.0
+                                               : c == 3 ? 1.0
+                                                        : 0.0),
+                             v);
+            v = nir_u2uN(&b, v, nir_alu_type_get_type_size(o->type));
+            nir_store_output(&b, v, nir_imm_int(&b, 0), .component = c,
+                             .src_type = o->type, .io_semantics = o->io);
+         }
+      }
+   }
+   b.shader->info.io_lowered = true;
+   nir_shader_gather_info(b.shader, b.impl);
+   return b.shader;
+}
+
+nir_shader *
+kk_nir_lower_geometry(nir_shader *gs, struct kk_geometry_info *info)
+{
+   struct geometry_lowering s = {.info = info};
+   s.width = nir_verts_in_output_prim(gs);
+   info->mode = u_reduced_prim(gs->info.gs.output_primitive);
+   info->invocations = gs->info.gs.invocations;
+   NIR_PASS(_, gs, nir_lower_io_to_scalar,
+            nir_var_shader_in | nir_var_shader_out, NULL, NULL);
+   NIR_PASS(_, gs, nir_opt_constant_folding);
+   nir_shader_intrinsics_pass(gs, gather, nir_metadata_all, &s);
+   if (info->vertices_out >= s.width)
+      info->max_indices = (info->vertices_out - s.width + 1) * s.width;
+
+   poly_nir_lower_gs_inputs(gs);
+   nir_lower_gs_intrinsics(
+      gs, nir_lower_gs_intrinsics_count_vertices_per_primitive);
+
+   nir_function_impl *impl = nir_shader_get_entrypoint(gs);
+   nir_builder b = nir_builder_at(nir_before_impl(impl));
+   s.gid = nir_load_global_invocation_id(&b, 32);
+   nir_def *count = PARAM(&b, geometry.grid[0], 32);
+   nir_push_if(&b, nir_uge(&b, nir_channel(&b, s.gid, 0), count));
+   nir_jump(&b, nir_jump_return);
+   nir_pop_if(&b, NULL);
+   nir_def *prim = nir_iadd(&b, nir_channel(&b, s.gid, 0),
+                            nir_imul(&b, nir_channel(&b, s.gid, 1), count));
+   nir_def *invocation = nir_iadd(&b, nir_imul_imm(&b, prim, info->invocations),
+                                  nir_channel(&b, s.gid, 2));
+   s.vertex_base =
+      nir_iadd_imm(&b, nir_imul_imm(&b, invocation, info->vertices_out), 1);
+   s.vertices = PARAM(&b, vertex_buffer, 64);
+   s.rasterize = nir_ine_imm(&b, PARAM(&b, info.max_indices, 32), 0);
+   s.index_base = element(&b, PARAM(&b, geometry.output_index_buffer, 64),
+                          invocation, info->max_indices * 4);
+   s.last = nir_ine_imm(&b, PARAM(&b, provoking_last, 32), 0);
+   s.index_count = nir_local_variable_create(impl, glsl_uint_type(), "indices");
+   nir_store_var(&b, s.index_count, nir_imm_int(&b, 0), 1);
+   nir_shader_intrinsics_pass(gs, lower, nir_metadata_none, &s);
+   nir_shader *raster = raster_vertex(gs, &s);
+   nir_lower_returns(gs);
+   gs->info.stage = MESA_SHADER_COMPUTE;
+   memset(&gs->info.cs, 0, sizeof(gs->info.cs));
+   gs->info.workgroup_size[0] = KK_GEOMETRY_GROUP_SIZE;
+   gs->info.workgroup_size[1] = gs->info.workgroup_size[2] = 1;
+   return raster;
+}
