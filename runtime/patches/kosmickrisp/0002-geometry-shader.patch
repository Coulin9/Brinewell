--- a/src/kosmickrisp/libkk/kk_geometry.cl
+++ b/src/kosmickrisp/libkk/kk_geometry.cl
@@ -9,6 +9,48 @@
 #include "compiler/libcl/libcl_vk.h"
 #include "poly/geometry.h"
 #include "poly/tessellator.h"
+#include "kk_geometry.h"
+
+KERNEL(1)
+libkk_geometry_setup(global struct kk_geometry_params *p,
+                     global struct poly_vertex_params *vp,
+                     global struct poly_heap *heap, constant uint32_t *draw,
+                     uint64_t index_address, uint32_t index_range_el,
+                     uint32_t index_size, uint64_t zero_address)
+{
+   uint vertices = draw[0], instances = draw[1];
+   uint prims = u_decomposed_prims_for_vertices(p->geometry.input_topology, vertices);
+   struct kk_geometry_layout layout;
+   if (!kk_geometry_layout(&layout, p->info, vertices, prims, instances, vp->outputs))
+      abort();
+   poly_vertex_params_set_draw(vp, vertices, instances);
+   p->geometry.grid[0] = prims;
+   p->geometry.grid[1] = instances;
+   p->geometry.grid[2] = p->info.invocations;
+   p->geometry.grid[3] = DIV_ROUND_UP(prims, KK_GEOMETRY_GROUP_SIZE);
+   p->geometry.grid[4] = instances;
+   p->geometry.grid[5] = p->info.invocations;
+
+   if (index_size) {
+      uint first = draw[2];
+      vp->index_buffer_range_el = poly_index_buffer_range_el(index_range_el, first);
+      vp->index_buffer = first < index_range_el
+         ? index_address + (uint64_t)first * index_size : zero_address;
+   }
+   /* Earlier tessellation/unroll buffers must survive the whole multidraw.
+    * Geometry capture dies with this draw. Reuse the free tail without
+    * advancing the shared heap cursor. KK orders successive encoder stages. */
+   uint offset = align(heap->bottom, 16);
+   if (offset > heap->size || layout.size > heap->size - offset)
+      abort();
+   global uchar *storage = heap->base + offset;
+   vp->output_buffer = (uintptr_t)storage;
+   p->vertex_buffer = (uintptr_t)(storage + layout.vertex_offset);
+   p->geometry.output_index_buffer = (global uint *)(storage + layout.index_offset);
+   p->geometry.draw.index_count = layout.index_count;
+   p->geometry.draw.first_index = (offset + layout.index_offset) / sizeof(uint);
+   p->geometry.draw.instance_count = 1;
+}
 
