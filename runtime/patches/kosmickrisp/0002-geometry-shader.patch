@@ -0,0 +1,46 @@
+/* SPDX-License-Identifier: MIT */
+#pragma once
+
+#include "poly/geometry.h"
+
+#define KK_GEOMETRY_GROUP_SIZE 32
+
+struct kk_geometry_info {
+   enum mesa_prim mode;
+   uint32_t invocations, vertices_out, max_indices, vertex_stride;
+};
+
+struct kk_geometry_params {
+   struct poly_geometry_params geometry;
+   uint64_t vertex_buffer;
+   uint32_t provoking_last;
+   struct kk_geometry_info info;
+} PACKED;
+
+/* All offsets are relative to one draw-local scratch allocation. */
+struct kk_geometry_layout {
+   uint32_t vertex_offset, index_offset, size, index_count;
+};
+
+static inline bool
+kk_geometry_layout(struct kk_geometry_layout *out, struct kk_geometry_info info,
+                   uint32_t vertices, uint32_t primitives, uint32_t instances,
+                   uint64_t outputs)
+{
+   uint64_t threads = (uint64_t)instances * primitives;
+   uint64_t vs_count = (uint64_t)vertices * instances;
+   if (threads > UINT32_MAX / info.invocations || vs_count > UINT32_MAX)
+      return false;
+   threads *= info.invocations;
+   uint64_t vs_bytes = vs_count * util_bitcount64(outputs) * 16;
+   uint64_t indices = threads * info.max_indices;
+   uint64_t records = info.max_indices ? 1 + threads * info.vertices_out : 0;
+   if (indices > UINT32_MAX / 4 || records > UINT32_MAX)
+      return false;
+   uint64_t index_offset = vs_bytes + records * info.vertex_stride;
+   uint64_t size = index_offset + indices * sizeof(uint32_t);
+   if (size > UINT32_MAX)
+      return false;
+   *out = (struct kk_geometry_layout){vs_bytes, index_offset, size, indices};
+   return true;
+}
