+/* Run the vertex-producing stage and GS on the GPU. The final Metal draw
+ * fetches captured vertices; its index order is independent of the input. */
+static struct kk_draw_data
+kk_launch_geometry(struct kk_cmd_buffer *cmd, struct kk_draw_data input,
+                   enum mesa_prim prim, uint32_t draw_id)
+{
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+   struct kk_shader *vs = cmd->state.shaders[MESA_SHADER_VERTEX];
+   struct kk_shader *tes = cmd->state.shaders[MESA_SHADER_TESS_EVAL];
+   struct kk_shader *gs = cmd->state.shaders[MESA_SHADER_GEOMETRY];
+   struct kk_geometry_info info = gs->info.gs;
+   if (cmd->vk.dynamic_graphics_state.rs.rasterizer_discard_enable)
+      info.max_indices = 0;
+   const uint32_t local[3] = {1, 1, 1};
+   struct kk_geometry_params params = {.info = info};
+   struct poly_vertex_params vp;
+   poly_geometry_params_init(&params.geometry, prim, local);
+   params.provoking_last = cmd->vk.dynamic_graphics_state.rs.provoking_vertex ==
+                           VK_PROVOKING_VERTEX_MODE_LAST_VERTEX_EXT;
+   poly_vertex_params_init(&vp, tes ? tes->info.tess.outputs_written :
+                                     vs->info.vs.outputs_written, local);
+
+   struct kk_draw_data output = {
+      .primitive_type = mesa_prim_to_mtl_primitive_type(info.mode),
+      .index.el_size_B = sizeof(uint32_t),
+   };
+   struct kk_grid vertex_grid, geometry_grid;
+   bool indirect = kk_grid_is_indirect(input.grid);
+   if (!indirect) {
+      uint32_t vertices = input.grid.size.x, instances = input.grid.size.y;
+      uint32_t prims = u_decomposed_prims_for_vertices(prim, vertices);
+      struct kk_geometry_layout layout;
+      if (!kk_geometry_layout(&layout, info, vertices, prims, instances, vp.outputs)) {
+         vk_command_buffer_set_error(&cmd->vk, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+         return (struct kk_draw_data){.grid = kk_grid_1d(0)};
+      }
+
+      poly_vertex_params_set_draw(&vp, vertices, instances);
+      if (input.index.el_size_B) {
+         vp.index_buffer = kk_sanitize_index_range(cmd, input.index.gpu).addr;
+         vp.index_buffer_range_el = input.index.gpu.range / input.index.el_size_B;
+      }
+      if (layout.size > gfx->geometry_scratch.range) {
+         uint32_t size = MAX2(layout.size, MIN2(UINT32_MAX, 2 * gfx->geometry_scratch.range));
+         struct kk_ptr storage = kk_pool_alloc(cmd, size, 16);
+         if (!storage.gpu)
+            return (struct kk_draw_data){.grid = kk_grid_1d(0)};
+         gfx->geometry_scratch = (struct kk_addr_range){storage.gpu, size};
+      }
+      vp.output_buffer = gfx->geometry_scratch.addr;
+      params.vertex_buffer = vp.output_buffer + layout.vertex_offset;
+      params.geometry.output_index_buffer = vp.output_buffer + layout.index_offset;
+      params.geometry.grid[0] = prims;
+      params.geometry.grid[1] = instances;
+      params.geometry.grid[2] = info.invocations;
+      vertex_grid = kk_grid_2d(vertices, instances);
+      geometry_grid = kk_grid_3d(prims, instances, info.invocations);
+      output.index.gpu = (struct kk_addr_range){
+         params.geometry.output_index_buffer, layout.size - layout.index_offset,
+      };
+      output.grid = kk_grid_3d(layout.index_count, 1, 0);
+   }
+
+   struct kk_ptr vptr = kk_pool_upload(cmd, &vp, sizeof(vp), 8);
+   struct kk_ptr gptr = kk_pool_upload(cmd, &params, sizeof(params), 8);
+   if (!vptr.gpu || !gptr.gpu)
+      return (struct kk_draw_data){.grid = kk_grid_1d(0)};
+   if (indirect) {
+      struct libkk_geometry_setup_args setup = {
+         .p = gptr.gpu, .vp = vptr.gpu, .heap = kk_heap(cmd),
+         .draw = input.grid.addr, .index_address = input.index.gpu.addr,
+         .index_size = input.index.el_size_B,
+      };
+      if (input.index.el_size_B) {
+         setup.index_range_el = input.index.gpu.range / input.index.el_size_B;
+         setup.zero_address = kk_sanitize_index_range(cmd, (struct kk_addr_range){0}).addr;
+      }
+      libkk_geometry_setup_struct(cmd, kk_grid_1d(1), true, setup);
+      vertex_grid = kk_grid_indirect(vptr.gpu + offsetof(struct poly_vertex_params, grid));
+      geometry_grid = kk_grid_indirect(gptr.gpu + offsetof(struct kk_geometry_params, geometry.grid[3]));
+      struct kk_bo *heap = kk_cmd_buffer_device(cmd)->heap;
+      output.index.gpu = (struct kk_addr_range){
+         heap->gpu + sizeof(struct poly_heap), heap->size_B - sizeof(struct poly_heap),
+      };
+      output.grid = kk_grid_indirect(gptr.gpu + offsetof(struct kk_geometry_params, geometry.draw));
+   }
+
+   struct kk_per_draw_data data = gfx->per_draw_data;
+   data.draw_id = draw_id;
+   data.index_size = input.index.el_size_B;
+   data.base_vertex_addr = upload_base_vertex(cmd, &input);
+   data.base_instance_addr = upload_base_instance(cmd, &input);
+   data.vertex_outputs = vp.outputs;
+   data.vertex_params = vptr.gpu;
+   data.geometry_params = gptr.gpu;
+   struct kk_ptr per_draw = kk_pool_upload(cmd, &data, sizeof(data), 8);
+   if (!per_draw.gpu)
+      return (struct kk_draw_data){.grid = kk_grid_1d(0)};
+   mtl_set_address(cmd->argument_table, per_draw.gpu, 2u);
+
+   mtl_compute_encoder *enc = cs_get_compute(cmd);
+   mtl_barrier_after_encoder_stages(enc, MTL_STAGE_DISPATCH, MTL_STAGE_DISPATCH);
+   mtl_compute_set_pipeline_state(enc, vs->pipeline.gfx.pre_render[tes ? 2 : 0]);
+   kk_dispatch_compute(enc, vertex_grid, (struct mtl_size){indirect ? 1u : 64u, 1, 1});
+   if (indirect || geometry_grid.size.x) {
+      mtl_barrier_after_encoder_stages(enc, MTL_STAGE_DISPATCH, MTL_STAGE_DISPATCH);
+      mtl_compute_set_pipeline_state(enc, vs->pipeline.gfx.gs_main);
+      kk_dispatch_compute(enc, geometry_grid, (struct mtl_size){KK_GEOMETRY_GROUP_SIZE, 1, 1});
+   }
+   return output;
+}
