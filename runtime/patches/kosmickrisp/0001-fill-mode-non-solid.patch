+++ b/src/kosmickrisp/compiler/polygon_points.metal
@@ -0,0 +1,216 @@
+/* SPDX-License-Identifier: MIT */
+
+/* A triangle gains at most one vertex per clip half-space. Carry barycentric
+ * weights through clipping, then interpolate each shader output only once.
+ * The generated prefix supplies VertexOut, shade_vertex, the varying
+ * interpolation function and any shader-declared clip/cull distances. */
+struct PolygonDraw {
+   constant uint *args;
+   device const uchar *indices;
+   ulong indexBytes;
+   uint indexSize, cull, clockwise, clipZ;
+   ulong flatMask, linearMask;
+   float biasConstant, biasSlope, biasClamp, fixedDepthStep;
+   float4 viewport[16]; /* inverse width/height, depth near/far */
+};
+
+inline uint
+read_vertex_id(constant PolygonDraw &d, uint element)
+{
+   if (!d.indexSize)
+      return d.args[2] + element;
+
+   ulong i = ulong(element) + d.args[2];
+   uint v = 0;
+   if (i < d.indexBytes / d.indexSize) {
+      if (d.indexSize == 4)
+         v = ((device const uint *)d.indices)[i];
+      else if (d.indexSize == 2)
+         v = ((device const ushort *)d.indices)[i];
+      else
+         v = d.indices[i];
+   }
+   return d.args[3] + v;
+}
+
+enum : uint { maxCorners = 3 + 6 + KK_CLIP_DISTANCES };
+
+/* Clip in place using a temporary polygon only when the triangle crosses
+ * this plane. Coincident boundary vertices must appear exactly once. */
+inline uint
+clip_polygon(thread float3 *poly, uint n, float3 distance)
+{
+   if (all(distance >= 0.0f))
+      return n;
+   if (all(distance < 0.0f) || !n)
+      return 0;
+
+   float3 output[maxCorners];
+   uint count = 0;
+   float3 prev = poly[n - 1];
+   float a = dot(prev, distance);
+   for (uint i = 0; i < n; ++i) {
+      float3 cur = poly[i];
+      float b = dot(cur, distance);
+      if ((a < 0 && b > 0) || (a > 0 && b < 0))
+         output[count++] = mix(prev, cur, a / (a - b));
+      if (b >= 0)
+         output[count++] = cur;
+      prev = cur;
+      a = b;
+   }
+   for (uint i = 0; i < count; ++i)
+      poly[i] = output[i];
+   return count;
+}
+
+struct PolygonVertex {
+   float4 position [[position]];
+#if KK_STENCIL_POINTS
+   float2 uv [[user(kk_point_coord)]];
+#else
+   float pointSize [[point_size]];
+#endif
+};
+
+#if KK_STENCIL_POINTS
+using PolygonMesh = mesh<PolygonVertex, PolygonPrimitive, 4 * maxCorners,
+                         2 * maxCorners, topology::triangle>;
+#else
+using PolygonMesh = mesh<PolygonVertex, PolygonPrimitive, maxCorners,
+                         maxCorners, topology::point>;
+#endif
+
+[[mesh]] void
+main_entrypoint(PolygonMesh out, uint amplification [[amplification_id]],
+                uint lane [[thread_index_in_threadgroup]],
+                uint3 group [[threadgroup_position_in_grid]],
+                uint simdWidth [[threads_per_simdgroup]],
+                uint simdLane [[thread_index_in_simdgroup]],
+                constant Buffer &buf0 [[buffer(0)]],
+                constant SamplerTable &sampler_table [[buffer(1)]],
+                constant Buffer &per_draw [[buffer(2)]],
+                constant PolygonDraw &d [[buffer(3)]])
+{
+   threadgroup VertexOut v[3];
+   threadgroup float3 weights[maxCorners];
+   threadgroup uint n;
+   threadgroup bool front;
+   threadgroup float depthBias;
+   if (lane < 3) {
+      uint baseInstance = d.args[d.indexSize ? 4 : 3];
+      uint baseVertex = d.args[d.indexSize ? 3 : 2];
+      v[lane] = shade_vertex(read_vertex_id(d, 3 * group.x + lane),
+                             baseInstance + group.y, baseInstance, baseVertex,
+                             amplification, simdWidth, simdLane, buf0,
+                             sampler_table, per_draw);
+   }
+   threadgroup_barrier(mem_flags::mem_threadgroup);
+
+   if (lane == 0) {
+      float3 x(v[0].position.x, v[1].position.x, v[2].position.x);
+      float3 y(v[0].position.y, v[1].position.y, v[2].position.y);
+      float3 z(v[0].position.z, v[1].position.z, v[2].position.z);
+      float3 w(v[0].position.w, v[1].position.w, v[2].position.w);
+      float3 p[maxCorners] = {float3(1, 0, 0), float3(0, 1, 0),
+                              float3(0, 0, 1)};
+      uint count = cull_distances(v) ? 0 : 3;
+      count = clip_polygon(p, count, w + x);
+      count = clip_polygon(p, count, w - x);
+      count = clip_polygon(p, count, w + y);
+      count = clip_polygon(p, count, w - y);
+      if (d.clipZ) {
+         count = clip_polygon(p, count, z);
+         count = clip_polygon(p, count, w - z);
+      }
+#if KK_CLIP_DISTANCES
+      for (uint i = 0; i < KK_CLIP_DISTANCES; ++i)
+         count = clip_polygon(
+            p, count,
+            float3(v[0].gl_ClipDistance[i], v[1].gl_ClipDistance[i],
+                   v[2].gl_ClipDistance[i]));
+#endif
+      const float4 vp = d.viewport[get_viewport(v[0])];
+      float area = 0, maxDepth = 0;
+      if (count) {
+         float2 last = float2(dot(p[count - 1], x), dot(p[count - 1], y)) /
+                       dot(p[count - 1], w);
+         for (uint i = 0; i < count; ++i) {
+            float2 xy = float2(dot(p[i], x), dot(p[i], y)) / dot(p[i], w);
+            area += last.x * xy.y - last.y * xy.x;
+            if (d.biasConstant != 0 && d.fixedDepthStep == 0) {
+               float depth = mix(vp.z, vp.w, dot(p[i], z) / dot(p[i], w));
+               maxDepth = max(maxDepth, abs(depth));
+            }
+            weights[i] = p[i];
+            last = xy;
+         }
+      }
+      depthBias = 0;
+      if (d.biasSlope != 0 || d.biasConstant != 0) {
+         /* Solve z = A*x + B*y + C*w in homogeneous coordinates. This
+          * keeps the slope valid if a vertex is behind the view plane. */
+         float slope = 0;
+         float det = dot(x, cross(y, w));
+         if (det != 0 && d.biasSlope != 0) {
+            float2 grad =
+               float2(dot(z, cross(y, w)), dot(z, cross(w, x))) / det;
+            grad *= 2 * vp.xy * (vp.w - vp.z);
+            slope = max(abs(grad.x), abs(grad.y));
+         }
+         float r = d.fixedDepthStep;
+         if (r == 0 && maxDepth > 0)
+            r = ldexp(1.f, ilogb(maxDepth) - 23);
+         float bias = slope * d.biasSlope + r * d.biasConstant;
+         depthBias = d.biasClamp > 0   ? min(d.biasClamp, bias)
+                     : d.biasClamp < 0 ? max(d.biasClamp, bias)
+                                       : bias;
+      }
+      bool flipped = vp.y < 0;
+      front = bool(d.clockwise) == flipped ? area < 0 : area > 0;
+      n = (d.cull & (front ? 1u : 2u)) ? 0u : count;
+      out.set_primitive_count((KK_STENCIL_POINTS ? 2 : 1) * n);
+   }
+   threadgroup_barrier(mem_flags::mem_threadgroup);
+   if (lane < n) {
+      VertexOut point =
+         interpolate_vertex(v, weights[lane], d.flatMask, d.linearMask);
+      const float4 vp = d.viewport[get_viewport(v[0])];
+      float depth =
+         mix(vp.z, vp.w, point.position.z / point.position.w) + depthBias;
+      point.position.z =
+         clamp(depth, min(vp.z, vp.w), max(vp.z, vp.w)) * point.position.w;
+      PolygonPrimitive primitive = primitive_payload(point, group.x, front);
+      PolygonVertex outVertex;
+#if KK_STENCIL_POINTS
+      /* Native points always select the front stencil state. Generate a
+       * one-pixel square with the polygon's original winding where hardware
+       * can select different front and back stencil operations. */
+      float2 inverse = vp.xy;
+      for (uint i = 0; i < 4; ++i) {
+         outVertex.uv = float2(i == 1 || i == 2, i >= 2);
+         outVertex.position = point.position;
+         outVertex.position.xy +=
+            (2 * outVertex.uv - 1) * inverse * point.position.w;
+         out.set_vertex(4 * lane + i, outVertex);
+      }
+      bool clockwise = front == bool(d.clockwise);
+      uint a = clockwise ? 1 : 3, b = 4 - a;
+      uint first = 4 * lane;
+      out.set_index(6 * lane + 0, first);
+      out.set_index(6 * lane + 1, first + a);
+      out.set_index(6 * lane + 2, first + 2);
+      out.set_index(6 * lane + 3, first);
+      out.set_index(6 * lane + 4, first + 2);
+      out.set_index(6 * lane + 5, first + b);
+      out.set_primitive(2 * lane, primitive);
+      out.set_primitive(2 * lane + 1, primitive);
+#else
+      outVertex.position = point.position;
+      outVertex.pointSize = 1;
+      out.set_vertex(lane, outVertex);
+      out.set_index(lane, lane);
+      out.set_primitive(lane, primitive);
+#endif
+   }
+}
