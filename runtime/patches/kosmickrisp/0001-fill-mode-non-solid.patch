    case INTERP_MODE_NOPERSPECTIVE:
       if (info.centroid)
          interp = "[[centroid_no_perspective]]";
@@ -269,9 +382,17 @@ fs_input_block(nir_shader *shader, struct nir_to_msl_ctx *ctx)
 {
    P(ctx, "struct FragmentIn {\n");
    ctx->indentlevel++;
+   if (ctx->polygon_points &&
+       BITSET_TEST(shader->info.system_values_read, SYSTEM_VALUE_FRONT_FACE))
+      P_IND(ctx, "uint kk_front [[user(kk_front), flat]];\n");
+   if (ctx->stencil_points &&
+       BITSET_TEST(shader->info.system_values_read, SYSTEM_VALUE_POINT_COORD))
+      P_IND(
+         ctx,
+         "float2 kk_point_coord [[user(kk_point_coord), center_no_perspective]];\n");
    u_foreach_bit64(location, shader->info.inputs_read) {
       struct io_slot_info info = ctx->inputs_info[location];
-      if (info.uses_interpolant)
+      if (!ctx->polygon_points && info.uses_interpolant)
          fs_input_interpolant(ctx, location);
       else
          fs_input_no_interpolant(ctx, location);
