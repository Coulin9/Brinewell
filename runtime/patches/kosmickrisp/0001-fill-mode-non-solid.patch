+/* Interpolate clipped vertices once per rasterized point. Its fragment
+ * inputs are constant across every covered sample. Keep the original
+ * interpolation modes for newly created clip intersections. */
+void
+msl_emit_polygon_helpers(struct nir_to_msl_ctx *ctx)
+{
+   nir_shader *s = ctx->shader;
+   P(ctx, "#define KK_STENCIL_POINTS %d\n", ctx->stencil_points);
+   P(ctx, "struct PolygonPrimitive { uint id [[primitive_id]]; "
+          "uint front [[user(kk_front)]];\n");
+   if (s->info.outputs_written & VARYING_BIT_VIEWPORT)
+      P(ctx, "uint viewport [[viewport_array_index]];\n");
+   if (s->info.outputs_written & VARYING_BIT_LAYER)
+      P(ctx, "uint layer [[render_target_array_index]];\n");
+   u_foreach_bit64(loc, s->info.outputs_written) {
+      if (!VARYING_SLOT_INFO[loc].user)
+         continue;
+      struct io_slot_info info = ctx->outputs_info[loc];
+      bool scalarized = VARYING_SLOT_INFO[loc].scalarized;
+      unsigned n = scalarized ? info.num_components : 1;
+      for (unsigned c = 0; c < n; c++) {
+         P(ctx, "%s%s ", alu_type_to_string(info.type),
+           scalarized ? "" : vector_suffixes[info.num_components]);
+         varying_slot_name(ctx, loc, c);
+         P(ctx, " ");
+         varying_slot_semantic(ctx, loc, c);
+         P(ctx, ";\n");
+      }
+   }
+   P(ctx, "};\n");
+   P(ctx,
+     "inline PolygonPrimitive primitive_payload(VertexOut v, uint id, bool front) {"
+     "PolygonPrimitive p; p.front = front; p.id = %s;\n",
+     s->info.outputs_written & VARYING_BIT_PRIMITIVE_ID ? "v.primitive_id"
+                                                        : "id");
+   if (s->info.outputs_written & VARYING_BIT_VIEWPORT)
+      P(ctx, "p.viewport = v.viewport_array_index;\n");
+   if (s->info.outputs_written & VARYING_BIT_LAYER)
+      P(ctx, "p.layer = v.render_target_array_index;\n");
+   u_foreach_bit64(loc, s->info.outputs_written) {
+      if (!VARYING_SLOT_INFO[loc].user)
+         continue;
+      unsigned n = VARYING_SLOT_INFO[loc].scalarized
+                      ? ctx->outputs_info[loc].num_components
+                      : 1;
+      for (unsigned c = 0; c < n; c++) {
+         P(ctx, "p.");
+         varying_slot_name(ctx, loc, c);
+         P(ctx, " = v.");
+         varying_slot_name(ctx, loc, c);
+         P(ctx, ";\n");
+      }
+   }
+   P(ctx, "return p; }\n");
+   P(ctx, "#define KK_CLIP_DISTANCES %u\n", s->info.clip_distance_array_size);
+   P(ctx, "inline uint get_viewport(VertexOut v) { return %s; }\n",
+     s->info.outputs_written & VARYING_BIT_VIEWPORT ? "v.viewport_array_index"
+                                                    : "0u");
+   P(ctx, "inline bool cull_distances(threadgroup VertexOut *v) {\n");
+   for (unsigned i = 0; i < s->info.cull_distance_array_size; i++) {
+      /* The existing vertex lowering writes a 0/1 vertex classification
+       * for each cull plane, used by the native fragment path. */
+      unsigned slot = VARYING_SLOT_CULL_PRIMITIVE + i / 4;
+      for (unsigned j = 0; j < 3; j++) {
+         P(ctx, "%s(v[%u].", j == 0 ? "if (" : " && ", j);
+         varying_slot_name(ctx, slot, i % 4);
+         P(ctx, " == 0)");
+      }
+      P(ctx, ") return true;\n");
+   }
+   P(ctx, "return false; }\n");
+   P(ctx,
+     "inline VertexOut interpolate_vertex(threadgroup VertexOut *v, "
+     "float3 b, ulong flatMask, ulong linearMask) {\n"
+     "uint original = b.x == 1 ? 0u : b.y == 1 ? 1u : b.z == 1 ? 2u : 3u;\n"
+     "VertexOut out = v[0];\n"
+     "float3 w = float3(v[0].position.w,v[1].position.w,v[2].position.w);\n"
+     "float3 linear = b*w / dot(b,w);\n");
+   u_foreach_bit64(loc, s->info.outputs_written) {
+      struct io_slot_info info = ctx->outputs_info[loc];
+      unsigned n = VARYING_SLOT_INFO[loc].scalarized ? info.num_components : 1;
+      for (unsigned c = 0; c < n; ++c) {
+         if (loc == VARYING_SLOT_CULL_PRIMITIVE ||
+             loc == VARYING_SLOT_CULL_PRIMITIVE + 1) {
+            P(ctx, "out.");
+            varying_slot_name(ctx, loc, c);
+            P(ctx, " = 1;\n");
+            continue;
+         }
+         if (nir_alu_type_get_base_type(info.type) != nir_type_float)
+            continue; /* Vulkan requires flat interpolation for integers. */
+         P(ctx,
+           "if (!(flatMask & (1ul << %u))) {\n"
+           "float3 k = (linearMask & (1ul << %u)) ? linear : b;\n",
+           (unsigned)loc, (unsigned)loc);
+         P(ctx, "out.");
+         varying_slot_name(ctx, loc, c);
+         P(ctx, " = original < 3 ? v[original].");
+         varying_slot_name(ctx, loc, c);
+         P(ctx, " : ");
+         for (unsigned j = 0; j < 3; ++j) {
+            if (j)
+               P(ctx, " + ");
+            P(ctx, "v[%u].", j);
+            varying_slot_name(ctx, loc, c);
+            P(ctx, " * k[%u]", j);
+         }
+         P(ctx, "; }\n");
+      }
+   }
+   P(ctx, "return out; }\n");
+}
