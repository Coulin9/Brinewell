diff --git a/src/kosmickrisp/vulkan/00-kk-defaults.conf b/src/kosmickrisp/vulkan/00-kk-defaults.conf
new file mode 100644
index 0000000..5ed1453
--- /dev/null
+++ b/src/kosmickrisp/vulkan/00-kk-defaults.conf
@@ -0,0 +1,8 @@
+<?xml version="1.0"?>
+<driconf>
+   <device driver="kosmickrisp">
+      <application name="DOOM Eternal" executable="DOOMEternalx64vk.exe">
+         <option name="kk_claim_wide_lines" value="true" />
+      </application>
+   </device>
+</driconf>
diff --git a/src/kosmickrisp/vulkan/kk_instance.c b/src/kosmickrisp/vulkan/kk_instance.c
index 90abd52..db913c5 100644
--- a/src/kosmickrisp/vulkan/kk_instance.c
+++ b/src/kosmickrisp/vulkan/kk_instance.c
@@ -20,6 +20,11 @@
 #include "util/mesa-blake3.h"
 #include "util/u_debug.h"
 
+static const driOptionDescription kk_driinfo[] = {
+   DRI_CONF_SECTION_DEBUG
+   DRI_CONF_OPT_B(kk_claim_wide_lines, false, "Claim wide line support")
+};
+
 VKAPI_ATTR VkResult VKAPI_CALL
 kk_EnumerateInstanceVersion(uint32_t *pApiVersion)
 {
@@ -112,6 +117,21 @@ kk_CreateInstance(const VkInstanceCreateInfo *pCreateInfo,
    if (result != VK_SUCCESS)
       goto fail_alloc;
 
+   driParseOptionInfo(&instance->available_options, kk_driinfo,
+                      ARRAY_SIZE(kk_driinfo));
+   const driConfigFileParseParams drirc_params = {
+      .screenNum = 0,
+      .driverName = "kosmickrisp",
+      .applicationName = instance->vk.app_info.app_name,
+      .applicationVersion = instance->vk.app_info.app_version,
+      .engineName = instance->vk.app_info.engine_name,
+      .engineVersion = instance->vk.app_info.engine_version,
+   };
+   driParseConfigFiles(&instance->options, &instance->available_options,
+                       &drirc_params);
+   instance->claim_wide_lines =
+      driQueryOptionb(&instance->options, "kk_claim_wide_lines");
+
    instance->vk.physical_devices.enumerate = kk_enumerate_physical_devices;
    instance->vk.physical_devices.destroy = kk_physical_device_destroy;
 
@@ -141,6 +161,8 @@ kk_CreateInstance(const VkInstanceCreateInfo *pCreateInfo,
    return VK_SUCCESS;
 
 fail_init:
+   driDestroyOptionCache(&instance->options);
+   driDestroyOptionInfo(&instance->available_options);
    vk_instance_finish(&instance->vk);
 fail_alloc:
    vk_free(pAllocator, instance);
@@ -158,6 +180,8 @@ kk_DestroyInstance(VkInstance _instance,
       return;
 
    vk_instance_finish(&instance->vk);
+   driDestroyOptionCache(&instance->options);
+   driDestroyOptionInfo(&instance->available_options);
    vk_free(&instance->vk.alloc, instance);
 }
 
diff --git a/src/kosmickrisp/vulkan/kk_instance.h b/src/kosmickrisp/vulkan/kk_instance.h
index c77a2e4..b799f57 100644
--- a/src/kosmickrisp/vulkan/kk_instance.h
+++ b/src/kosmickrisp/vulkan/kk_instance.h
@@ -16,6 +16,10 @@
 struct kk_instance {
    struct vk_instance vk;
 
+   struct driOptionCache options;
+   struct driOptionCache available_options;
+   bool claim_wide_lines;
+
    uint8_t driver_build_sha[VK_UUID_SIZE];
    uint32_t force_vk_vendor;
 };
