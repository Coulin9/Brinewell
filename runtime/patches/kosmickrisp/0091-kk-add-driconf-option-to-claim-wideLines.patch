@@ -237,6 +237,7 @@ kk_get_device_extensions(const struct kk_instance *instance,
 
 static void
 kk_get_device_features(
+   const struct kk_instance *instance,
    const struct kk_physical_device *pdev,
    const struct vk_device_extension_table *supported_extensions,
    struct vk_features *features)
@@ -288,6 +289,7 @@ kk_get_device_features(
       .textureCompressionBC = true,
       .textureCompressionETC2 = true,
       .vertexPipelineStoresAndAtomics = true,
+      .wideLines = instance->claim_wide_lines,
 
       /* Vulkan 1.1 */
       .multiview = true,
@@ -1247,7 +1249,7 @@ kk_enumerate_physical_devices(struct vk_instance *_instance)
    kk_get_device_extensions(instance, pdev, &supported_extensions);
 
    struct vk_features supported_features;
-   kk_get_device_features(pdev, &supported_extensions, &supported_features);
+   kk_get_device_features(instance, pdev, &supported_extensions, &supported_features);
 
    struct vk_properties properties;
    kk_get_device_properties(pdev, instance, &supported_extensions, &properties);
