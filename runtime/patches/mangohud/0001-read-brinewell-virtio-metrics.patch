+#pragma once
+
+#include <cstdint>
+#include <fstream>
+#include <vector>
+#ifdef __linux__
+#include <unistd.h>
+#endif
+
+struct BrinewellTelemetry {
+    struct Core {
+        char tier;
+        unsigned die;
+        unsigned id;
+        int mhz;
+        int busy;
+        int millidegrees;
+    };
+
+    int64_t gpu_busy = -1;
+    int64_t gpu_hz = -1;
+    int64_t gpu_millidegrees = -1;
+    int64_t gpu_microwatts = -1;
+    int64_t gpu_memory_bytes = -1;
+    int64_t cpu_millidegrees = -1;
+    int64_t cpu_microwatts = -1;
+    int64_t cpu_busy = -1;
+    int64_t cpu_mhz = -1;
+    int64_t ram_used_bytes = -1;
+    int64_t ram_total_bytes = -1;
+    std::vector<Core> cores;
+
+    static bool enabled() {
+#ifdef __linux__
+        static const bool present = access("/sys/devices/platform/brinewell_telemetry", F_OK) == 0;
+        return present;
+#else
+        return false;
+#endif
+    }
+
+    static BrinewellTelemetry read() {
+        std::ifstream file("/run/brinewell-telemetry/snapshot");
+        BrinewellTelemetry sample;
+        unsigned version;
+        if (!(file >> version >> sample.gpu_busy >> sample.gpu_hz >> sample.gpu_millidegrees
+                   >> sample.gpu_microwatts >> sample.gpu_memory_bytes >> sample.cpu_millidegrees
+                   >> sample.cpu_microwatts >> sample.cpu_busy >> sample.cpu_mhz
+                   >> sample.ram_used_bytes >> sample.ram_total_bytes) || (version != 1 && version != 2))
+            return {};
+        if (version == 2) {
+            unsigned count;
+            if (!(file >> count) || count > 64)
+                return {};
+            sample.cores.reserve(count);
+            for (unsigned i = 0; i < count; ++i) {
+                Core core{};
+                if (!(file >> core.tier >> core.die >> core.id >> core.mhz >> core.busy >> core.millidegrees))
+                    return {};
+                sample.cores.push_back(core);
+            }
+        }
+        file >> std::ws;
+        if (!file.eof())
+            return {};
+        return sample;
+    }
+
+    static float gibibytes(int64_t bytes) {
+        return bytes < 0 ? -1.0f : bytes / 1073741824.0f;
+    }
+};
