+static void brinewell_core_load() {
+    const auto cores = cpuStats.GetBrinewellCores();
+    const auto& text_color = HUDElements.colors.text;
+    if (!cores || cores->empty()) {
+        ImguiNextColumnFirstItem();
+        HUDElements.TextColored(HUDElements.colors.cpu, "CPU cores");
+        ImguiNextColumnOrNewRow();
+        HUDElements.TextColored(text_color, "--");
+        return;
+    }
+
+    const bool multiple_dies = std::any_of(cores->begin(), cores->end(), [](const auto& core) { return core.die != 0; });
+    const bool fahrenheit = HUDElements.params->enabled[OVERLAY_PARAM_ENABLED_temp_fahrenheit];
+    ImGui::PushFont(HUDElements.sw_stats->font_small);
+    for (const auto& core : *cores) {
+        ImguiNextColumnFirstItem();
+        const char tier = core.tier == '_' ? ' ' : core.tier;
+        if (multiple_dies)
+            HUDElements.TextColored(HUDElements.colors.cpu, "D%u %c%u", core.die, tier, core.id);
+        else
+            HUDElements.TextColored(HUDElements.colors.cpu, "CPU %c%u", tier, core.id);
+
+        ImguiNextColumnOrNewRow();
+        if (core.busy >= 0)
+            HUDElements.TextColored(text_color, "%d%%", (core.busy + 50) / 100);
+        else
+            HUDElements.TextColored(text_color, "--");
+
+        ImguiNextColumnOrNewRow();
+        if (core.mhz >= 0)
+            HUDElements.TextColored(text_color, "%d MHz", core.mhz);
+        else
+            HUDElements.TextColored(text_color, "-- MHz");
+        ImGui::SameLine();
+        if (core.millidegrees >= 0) {
+            const int celsius = (core.millidegrees + 500) / 1000;
+            const int temp = fahrenheit ? HUDElements.convert_to_fahrenheit(celsius) : celsius;
+            HUDElements.TextColored(text_color, "%d°%c", temp, fahrenheit ? 'F' : 'C');
+        } else {
+            HUDElements.TextColored(text_color, "--°%c", fahrenheit ? 'F' : 'C');
+        }
+    }
+    ImGui::PopFont();
 }
 
