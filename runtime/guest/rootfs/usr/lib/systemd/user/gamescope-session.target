# SPDX-License-Identifier: MIT
# Derived from Valve Corporation's deckard-steamvr-session (MIT)
# brinewell: full replacement of the stock target, without the SteamVR units
# (steamvr, steamvr-logs, steamvr-proxmicmute, steamvr-v4l2cam).
[Unit]
Description=Gamescope Session (brinewell VM)
Requires=graphical-session.target
BindsTo=graphical-session.target
After=graphical-session.target
PropagatesStopTo=graphical-session.target

Requires=gamescope-session.service
BindsTo=gamescope-session.service

Wants=steam.service
Wants=brinewell-gamescope-clipboard.service
Wants=steam-notif-daemon.service
Wants=ibus-gamescope.service
