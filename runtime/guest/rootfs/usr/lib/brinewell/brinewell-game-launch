#!/usr/bin/python3
"""Apply one explicitly selected game profile around Steam's original command."""

import argparse
import os
from pathlib import Path
import signal
import subprocess
import sys
import time

sys.dont_write_bytecode = True
from game_patches import PATCHES, prepare, try_seed_rdr2


WINE_SERVICES = {
    "wineserver", "wineserver64", "services.exe", "explorer.exe",
    "winedevice.exe", "plugplay.exe", "rpcss.exe", "svchost.exe", "conhost.exe",
}
HANDOFF_SECONDS = 30


def process_info(pid):
    try:
        directory = Path("/proc") / str(pid)
        fields = (directory / "stat").read_text().rsplit(")", 1)[1].split()
        return {"pid": pid, "parent": int(fields[1]), "started": int(fields[19]),
                "uid": directory.stat().st_uid,
                "name": (directory / "comm").read_text().strip().lower(),
                "group": (directory / "cgroup").read_text()}
    except (OSError, ValueError, IndexError):
        return None


def same_prefix(pid, prefix):
    try:
        values = (Path("/proc") / str(pid) / "environ").read_bytes().split(b"\0")
        value = next((value[11:] for value in values if value.startswith(b"WINEPREFIX=")), None)
        return value is not None and Path(os.fsdecode(value)).resolve() == Path(prefix)
    except OSError:
        return False


def collect_members(processes, members, scopes, appid):
    members = {pid: started for pid, started in members.items()
               if pid in processes and processes[pid]["started"] == started}
    previous_size = -1
    while previous_size != len(members):
        previous_size = len(members)
        for pid, process in processes.items():
            if process["parent"] in members:
                members[pid] = process["started"]
    scopes = set(scopes)
    for pid in members:
        group = processes[pid]["group"]
        if "app-steam-app" + appid + "-" in group:
            scopes.add(group)
    return members, scopes


def watch_finished(command_running, game_seen, game_running, launcher_running, now, deadline):
    if command_running or game_running:
        return False, None
    if game_seen:
        return True, None
    if launcher_running:
        return False, None
    if deadline is None:
        deadline = now + HANDOFF_SECONDS
    return now >= deadline, deadline


def run_with_affinity(command, environment, identity):
    try:
        cpus = os.sched_getaffinity(0) - {0}
    except (AttributeError, OSError):
        cpus = set()
    if not cpus:
        print("brinewell-game-launch: no separate CPU set is available; affinity adjustment skipped", file=sys.stderr)
        os.execvpe(command[0], command, environment)

    def child_affinity():
        try:
            os.sched_setaffinity(0, cpus)
        except OSError:
            os.write(2, b"brinewell-game-launch: could not set initial game affinity\n")

    child = subprocess.Popen(command, env=environment, preexec_fn=child_affinity)
    root = process_info(child.pid)
    members = {child.pid: root["started"]} if root else {}
    scopes = set()
    earliest = root["started"] if root else 0
    pending_signal = None
    affinity_warning = False

    def receive_signal(number, _frame):
        nonlocal pending_signal
        pending_signal = number

    for number in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(number, receive_signal)
    grace_until = None
    game_seen = False
    while True:
        processes = {}
        for directory in Path("/proc").glob("[0-9]*"):
            process = process_info(int(directory.name))
            if process and process["uid"] == os.getuid():
                processes[process["pid"]] = process
        members, scopes = collect_members(processes, members, scopes, identity["appid"])
        # The Windows launcher may exit before its successor is reparented.
        # Only adopt later processes from the exact scope and prefix already
        # observed in this launch, retaining their start time against PID reuse.
        for pid, process in processes.items():
            if (process["group"] in scopes and process["started"] >= earliest
                    and same_prefix(pid, identity["prefix"])):
                members[pid] = process["started"]
        targets = []
        game_targets = []
        for pid, process in processes.items():
            if process["name"] not in identity["processes"]:
                continue
            owned = pid in members or (process["group"] in scopes and process["started"] >= earliest)
            if not owned or not same_prefix(pid, identity["prefix"]):
                continue
            members[pid] = process["started"]
            targets.append(pid)
            if process["name"] == identity["game"]:
                game_targets.append(pid)
            try:
                for task in (Path("/proc") / str(pid) / "task").iterdir():
                    if os.sched_getaffinity(int(task.name)) != cpus:
                        os.sched_setaffinity(int(task.name), cpus)
            except OSError as error:
                if not affinity_warning:
                    print("brinewell-game-launch: worker affinity adjustment failed: " + str(error), file=sys.stderr)
                    affinity_warning = True
        if pending_signal is not None:
            for pid, started in members.items():
                current = process_info(pid)
                if current and current["started"] == started:
                    try:
                        os.kill(pid, pending_signal)
                    except ProcessLookupError:
                        pass
            pending_signal = None
        status = child.poll()
        game_seen = game_seen or bool(game_targets)
        launcher_running = any(processes[pid]["name"] not in WINE_SERVICES for pid in members)
        finished, grace_until = watch_finished(status is None, game_seen, bool(game_targets),
                                              launcher_running, time.monotonic(), grace_until)
        if finished:
            return status if status >= 0 else 128 - status
        time.sleep(2 if targets or game_seen else 0.2)


def run_with_deferred_seed(command, environment, seed):
    child = subprocess.Popen(command, env=environment)

    def forward_signal(number, _frame):
        try:
            child.send_signal(number)
        except ProcessLookupError:
            pass

    for number in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(number, forward_signal)
    while child.poll() is None:
        try:
            if try_seed_rdr2(seed["prefix"], seed["state"], nonblocking=True):
                break
        except BlockingIOError:
            pass
        try:
            child.wait(timeout=0.5)
        except subprocess.TimeoutExpired:
            pass
    status = child.wait()
    return status if status >= 0 else 128 - status


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--profile", required=True,
                        choices=[*PATCHES.values(), *PATCHES])
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command:
        parser.error("provide Steam's command after --")
    cmdline = Path("/proc/cmdline").read_text()
    command, environment, identity = prepare(args.profile, command, os.environ, cmdline)
    if identity is None:
        print("brinewell-game-launch: profile did not match this launch; using the original command", file=sys.stderr)
    elif identity["affinity"]:
        return run_with_affinity(command, environment, identity)
    elif identity.get("deferred_seed"):
        return run_with_deferred_seed(command, environment, identity["deferred_seed"])
    os.execvpe(command[0], command, environment)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError) as error:
        print("brinewell-game-launch: " + str(error), file=sys.stderr)
        raise SystemExit(1)
