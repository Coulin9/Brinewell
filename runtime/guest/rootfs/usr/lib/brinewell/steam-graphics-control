#!/usr/bin/env python3
"""fx.graphics device service: publish ready, apply backend <mode>, ack applied.

Reads bounded lines from the virtio port; on EOF (host closed the port) exits
nonzero so systemd restarts and re-announces readiness. Overlong lines are
drained to the newline and rejected without corrupting the pending buffer.
"""

import json
import os
import selectors
import socket
import stat
import sys
import tempfile
import time
import uuid
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import brinewell_graphics as graphics

DEVICE = "/dev/virtio-ports/fx.graphics"
STATE = "/run/brinewell/graphics-backend"
HDR_STATE = "/run/brinewell/hdr/display.json"
MODES = set(graphics.LIVE_MODES)
CLIENT_TIMEOUT = 1.0
RESOLVE_TIMEOUT = 6.0
MAX_PENDING = 16
MAX_CLIENT_CONNS = 32
MAX_LINE = 4096


def _log(message):
    print(f"steam-graphics-control: {message}", file=sys.stderr)


def _write_all(f, data):
    """FileIO.write on a character device may be partial; keep writing."""
    view = memoryview(data)
    while view:
        written = f.write(view)
        if written is None or written <= 0:
            raise OSError("port write returned no progress")
        view = view[written:]


def _apply(mode, f):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as handle:
        handle.write(mode + "\n")
    os.chmod(tmp, 0o644)
    os.replace(tmp, STATE)
    _write_all(f, ("applied " + mode + "\n").encode())


def _apply_hdr(values, f):
    directory = os.path.dirname(HDR_STATE)
    os.makedirs(directory, mode=0o755, exist_ok=True)
    os.chmod(directory, 0o755)
    data = dict(zip(("supported", "max_nits", "max_fall_nits",
                     "min_nits_10000ths", "sdr_nits"), values))
    data["supported"] = bool(data["supported"])
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".display-")
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump(data, handle)
            handle.write("\n")
        os.chmod(tmp, 0o644)
        os.replace(tmp, HDR_STATE)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
    _write_all(f, b"applied hdr\n")


def serve(f):
    """Multiplex host commands and bounded local resolution requests."""
    path = os.environ.get("BRINEWELL_GRAPHICS_RESOLVE_SOCK", graphics.DEFAULT_RESOLVE_SOCK)
    listener = None
    selector = selectors.DefaultSelector()
    bound = False
    clients = {}  # socket -> [request bytes, deadline, request id]
    pending = {}  # request id -> socket
    host_buffer = b""
    draining = False

    def close_client(client, response=None):
        state = clients.pop(client, None)
        if state:
            try:
                selector.unregister(client)
            except (KeyError, OSError, ValueError):
                pass
            if state[2]:
                pending.pop(state[2], None)
        if response:
            try:
                client.sendall(response + b"\n")
            except OSError:
                pass
        client.close()

    def host_line(line):
        try:
            parts = line.decode("utf-8").strip().split(" ")
        except UnicodeDecodeError:
            _log("undecodable request rejected")
            return
        if len(parts) == 3 and parts[0] == "resolved":
            if parts[2] in graphics.RESOLUTION_TOKENS and parts[1] in pending:
                close_client(pending[parts[1]], parts[2].encode())
        elif len(parts) == 2 and parts[0] == "backend" and parts[1] in MODES:
            try:
                _apply(parts[1], f)
            except OSError as error:
                _log(f"apply failed: {error}")
        elif (len(parts) == 6 and parts[0] == "hdr"
              and parts[1] in ("0", "1")
              and all(part and all("0" <= c <= "9" for c in part)
                      for part in parts[2:])):
            try:
                values = [int(part) for part in parts[1:]]
                if any(value > 65535 for value in values[1:]):
                    _log("HDR value out of range")
                    return
                _apply_hdr(values, f)
            except (OSError, ValueError) as error:
                _log(f"HDR apply failed: {error}")
        elif parts != [""]:
            _log(f"unknown request rejected: {parts[0][:32]}")

    try:
        if path:
            directory = os.path.dirname(path) or "."
            if directory == "/run/brinewell":
                try:
                    os.mkdir(directory, 0o755)
                except FileExistsError:
                    pass
                else:
                    os.chmod(directory, 0o755)
            else:
                os.makedirs(directory, mode=0o755, exist_ok=True)
            # Do not unlink arbitrary files at a configured socket path.
            try:
                if not stat.S_ISSOCK(os.lstat(path).st_mode):
                    raise OSError("resolve path exists and is not a socket")
                os.unlink(path)
            except FileNotFoundError:
                pass
            listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            listener.bind(path)
            bound = True
            os.chmod(path, 0o666)
            listener.listen(32)
            listener.setblocking(False)
        regular_host = stat.S_ISREG(os.fstat(f.fileno()).st_mode)
        if not regular_host:
            selector.register(f, selectors.EVENT_READ)
        if listener:
            selector.register(listener, selectors.EVENT_READ)
        _write_all(f, b"ready\n")
        while True:
            now = time.monotonic()
            for client, state in list(clients.items()):
                if state[1] <= now:
                    close_client(client, b"venus")
            timeout = min((state[1] - now for state in clients.values()), default=None)
            events = selector.select(0 if regular_host else timeout)
            readable = [key.fileobj for key, _ in events]
            if regular_host:
                readable.insert(0, f)
            for source in readable:
                if source is f:
                    try:
                        chunk = os.read(f.fileno(), 4096)
                    except OSError as error:
                        _log(f"read failed: {error}")
                        return 2
                    if not chunk:
                        return 2
                    for byte in chunk:
                        if byte == 10:
                            if not draining:
                                host_line(host_buffer)
                            host_buffer = b""
                            draining = False
                        elif not draining:
                            host_buffer += bytes((byte,))
                            if len(host_buffer) > MAX_LINE:
                                _log("overlong request rejected")
                                host_buffer = b""
                                draining = True
                elif source is listener:
                    client = None
                    try:
                        client, _ = listener.accept()
                        client.setblocking(False)
                        if len(clients) >= MAX_CLIENT_CONNS:
                            close_client(client, b"venus")
                            continue
                        selector.register(client, selectors.EVENT_READ)
                        clients[client] = [b"", time.monotonic() + CLIENT_TIMEOUT, None]
                    except OSError:
                        if client is not None:
                            close_client(client)
                elif source in clients:
                    state = clients[source]
                    try:
                        data = source.recv(65)
                    except OSError:
                        close_client(source)
                        continue
                    if not data:
                        close_client(source)
                        continue
                    if state[2] is not None:
                        continue
                    state[0] += data
                    if len(state[0]) > 64:
                        close_client(source, b"venus")
                    elif b"\n" in state[0]:
                        line = state[0].split(b"\n", 1)[0]
                        try:
                            appid = line.decode("ascii")
                        except UnicodeDecodeError:
                            appid = ""
                        if not graphics.valid_app_id(appid) or len(pending) >= MAX_PENDING:
                            close_client(source, b"venus")
                            continue
                        req_id = uuid.uuid4().hex
                        state[1:] = [time.monotonic() + RESOLVE_TIMEOUT, req_id]
                        pending[req_id] = source
                        try:
                            _write_all(f, f"resolve {req_id} {appid}\n".encode())
                        except OSError as error:
                            _log(f"write failed: {error}")
                            return 1
    except OSError as error:
        _log(f"service failed: {error}")
        return 1
    finally:
        for client in list(clients):
            close_client(client, b"venus")
        if listener:
            listener.close()
        selector.close()
        if bound:
            try:
                os.unlink(path)
            except OSError:
                pass


def main(device=DEVICE):
    try:
        fd = os.open(device, os.O_RDWR)
    except OSError as error:
        _log(f"cannot open {device}: {error}")
        return 1
    # Raw FileIO: the port is a character device, not a seekable file.
    with os.fdopen(fd, "r+b", buffering=0) as f:
        return serve(f)


if __name__ == "__main__":
    sys.exit(main())
