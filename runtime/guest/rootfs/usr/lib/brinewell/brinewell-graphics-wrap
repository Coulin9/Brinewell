#!/usr/bin/env python3
"""pressure-vessel bwrap delegate applying the selected Brinewell graphics backend.

steam-gfx-env sets PRESSURE_VESSEL_BWRAP to this script as a per-launch default
only when the inherited/user configuration does not already name a delegate.
The recognized game boundary is `--args FD pv-adverb ... -- [FEXCompatTool]
<tool>/proton <verb> ...`: bwrap's parse_args_recurse continues the outer argv
after the nested argfile list, so injected options go between `--args FD` and
the pv-adverb tail; the original argv is preserved and argfile offsets are preserved. Any
launch that is not a validated Proton game under an exact STEAM_COMPAT_TOOL_PATHS
tool root executes the delegate with byte-identical arguments.
"""

import array
import fcntl
import hashlib
import json
import os
from pathlib import Path
import stat
import sys
import tempfile

sys.path.insert(0, str(Path(__file__).resolve().parent))
import brinewell_graphics as graphics

PAYLOAD = graphics.PAYLOAD
CONTAINER_PAYLOAD = graphics.CONTAINER_PAYLOAD
# Opt-in development payload with the same layout as PAYLOAD; used instead of
# the packaged payload when it contains payload.json (fast iteration).
DEV_PAYLOAD = Path.home() / ".local/share/brinewell/neptune-dev"
GRAPHICS_DLLS = graphics.GRAPHICS_DLLS
SRT_BWRAP_REL = "libexec/steam-runtime-tools-0/srt-bwrap"
# Per-game NGX payload (enabled by default): nvapi64.dll is bound over
# the selected tool's own copy source so Proton's setup_prefix installs it,
# while nvngx.dll stays a managed single file inside the game prefix.
NGX_KEYS = ("nvngx", "nvapi64", "_nvngx")
NGX_MANAGED = ("nvngx.dll",)
# v1 markers may still claim nvapi64.dll; the claim is parsed but never
# grants ownership of the prefix file.
NGX_LEGACY = ("nvapi64.dll",)
NGX_MARKER = ".brinewell-ngx-sr.json"
NGX_LOCK = ".brinewell-ngx-sr.lock"
HDR_DIR = Path("/run/brinewell/hdr")


def _log(message):
    print(f"brinewell-graphics-wrap: {message}", file=sys.stderr)


def _mode():
    try:
        mode = Path("/run/brinewell/graphics-backend").read_text().strip()
        if mode in ("venus", "neptune", "mullion"):
            return mode
    except OSError:
        pass
    return "venus"


def _backend(mode):
    """neptune = D3DMetal; mullion carries its own backend name."""
    return "mullion" if mode == "mullion" else "d3dmetal"


def _slr_srt_bwrap(root):
    candidate = Path(root) / "pressure-vessel-arm64" / SRT_BWRAP_REL
    return str(candidate) if candidate.is_file() else None


def _cmdline_words(pid):
    try:
        data = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return []
    return [w.decode("utf-8", "surrogateescape") for w in data.split(b"\0") if w]


def _delegate(exe=None):
    """The trusted srt-bwrap of the actual invoking Steam Linux Runtime.

    exe is the resolved /proc/<ppid>/exe (a parameter only for tests). The
    delegate is always found inside a real SLR installation; argv-provided
    paths are never trusted.
    """
    if exe is None:
        try:
            exe = Path(f"/proc/{os.getppid()}/exe").resolve()
        except OSError:
            return None
    else:
        exe = Path(exe).resolve()
    pv_like = exe.name == "pressure-vessel-wrap"
    if pv_like:
        # <SLR>/pressure-vessel-arm64/bin/pressure-vessel-wrap -> sibling libexec
        found = exe.parents[1] / SRT_BWRAP_REL
        if found.is_file():
            return str(found)
    else:
        # Intermediary (e.g. the FEX python entry): the SLR is the tool root
        # named in the caller's own cmdline, validated against TOOL_PATHS.
        tools = {Path(os.path.realpath(t))
                 for t in os.environ.get("STEAM_COMPAT_TOOL_PATHS", "").split(":") if t}
        for word in _cmdline_words(os.getppid()):
            if Path(word).name != "_v2-entry-point":
                continue
            root = Path(os.path.realpath(word)).parent
            if root not in tools:
                continue
            found = _slr_srt_bwrap(root)
            if found:
                return found
        # Ordinary probe/unrecognized caller: any validated SLR's delegate.
        for root in sorted(tools):
            found = _slr_srt_bwrap(root)
            if found:
                return found
    if pv_like:
        # A real game launch must not silently switch to a different bwrap.
        return None
    distro = Path("/usr/bin/bwrap")
    if distro.is_file():
        return str(distro)
    return None


EXT2_IOC_GETFLAGS = 0x80086601
EXT2_IOC_SETFLAGS = 0x40086602
EXT4_CASEFOLD_FL = 0x40000000


def _set_casefold(path):
    """Best-effort EXT4_CASEFOLD_FL on a just-created empty directory,
    mirroring Proton's set_dir_casefold_bit (all errors ignored)."""
    fd = None
    try:
        fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
        flags = array.array("I", [0])
        fcntl.ioctl(fd, EXT2_IOC_GETFLAGS, flags, True)
        flags[0] |= EXT4_CASEFOLD_FL
        fcntl.ioctl(fd, EXT2_IOC_SETFLAGS, flags)
    except OSError:
        pass
    finally:
        if fd is not None:
            os.close(fd)


def _payload():
    """(root, container_root, extra_binds) for the active Neptune payload.

    The dev payload is bound at its own path so it is visible inside the
    container whether or not the home directory is shared.
    """
    if (DEV_PAYLOAD / "payload.json").is_file():
        return DEV_PAYLOAD, DEV_PAYLOAD, \
            ["--ro-bind", str(DEV_PAYLOAD), str(DEV_PAYLOAD)]
    return PAYLOAD, CONTAINER_PAYLOAD, []


def _prefix_system32(compat, create):
    """The prefix's safe system32 path, or None. With create the missing chain
    is made like _ensure_prefix_nptunix does; without it a missing component
    just means there is nothing to touch. Symlink and non-directory
    components are always refused."""
    node = Path(compat)
    if not node.is_dir():
        _log(f"compatdata {compat} is not a directory: passing through")
        return None
    try:
        for name in ("pfx", "drive_c", "windows", "system32"):
            node = node / name
            if node.is_symlink():
                _log(f"prefix component {node} is a symlink: passing through")
                return None
            if not node.exists():
                if not create:
                    return None
                os.mkdir(node, 0o755)
                if name == "drive_c":
                    # Proton sets casefold right after creating drive_c; it
                    # only works on an empty directory, so do it now.
                    _set_casefold(node)
            elif not node.is_dir():
                _log(f"prefix component {node} is not a directory: passing through")
                return None
    except OSError as error:
        _log(f"cannot create prefix dirs under {compat}: {error}")
        return None
    return node


def _ensure_prefix_nptunix(compat, arch, root):
    """Keep <compat>/pfx/drive_c/windows/system32/nptunix.dll byte-identical
    to the payload copy. Wine only loads a builtin that also has a file inside
    the prefix, so nptunix=b fails (c0000135) without it. On a prefix Proton
    has not created yet the directory chain is made here (Proton's copy_pfx
    tolerates pre-existing dirs and files). False means the prefix could not
    be made safe and Neptune must not be injected.
    """
    system32 = _prefix_system32(compat, create=True)
    if system32 is None:
        return False
    try:
        payload = (root / f"{arch}-windows/nptunix.dll").read_bytes()
        target = system32 / "nptunix.dll"
        if not target.is_symlink() and target.is_file() \
                and target.read_bytes() == payload:
            return True
        fd, temp = tempfile.mkstemp(dir=system32)
        try:
            with os.fdopen(fd, "wb") as handle:
                handle.write(payload)
            os.chmod(temp, 0o755)
            # os.replace renames over any existing entry, symlink included.
            os.replace(temp, target)
        except BaseException:
            try:
                os.unlink(temp)
            except OSError:
                pass
            raise
        return True
    except OSError as error:
        _log(f"cannot sync prefix nptunix.dll under {compat}: {error}")
        return False


def _sha256(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _sha256_fd(fd):
    digest = hashlib.sha256()
    with os.fdopen(fd, "rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _ngx_requested(env):
    return env.get("BRINEWELL_NGX_SR", "").strip().lower() in ("", "1", "true", "yes", "on")


def _ngx_overridden(env):
    """True when the user's WINEDLLOVERRIDES already covers an NGX name."""
    for entry in env.get("WINEDLLOVERRIDES", "").split(";"):
        left = entry.strip().split("=")[0]
        for key in left.split(","):
            key = key.strip().lower()
            if key.endswith(".dll"):
                key = key[:-4]
            if key and (key in NGX_KEYS or "*" in key or "?" in key):
                return True
    return False


def _ngx_nvapi_disabled(env):
    """True when the user explicitly disabled Proton's NVAPI install."""
    off = env.get("PROTON_DISABLE_NVAPI", "").strip().lower()
    if off in ("1", "true", "yes"):
        return True
    return env.get("PROTON_ENABLE_NVAPI", "").strip().lower() in \
        ("0", "false", "no")


def _ngx_marker(compat):
    """Digests this helper recorded, keyed by the fixed managed names.

    The marker is untrusted data: a missing entry yields {}, while a
    symlink, non-regular file, unparseable JSON, non-dict top level or any
    unexpected file key/digest fails the whole schema check and also
    yields {} (the marker never contributes delete paths)."""
    try:
        cfd = os.open(compat, os.O_RDONLY | os.O_DIRECTORY)
    except OSError:
        return {}
    try:
        try:
            info = os.stat(NGX_MARKER, dir_fd=cfd, follow_symlinks=False)
        except OSError:
            return {}
        if not stat.S_ISREG(info.st_mode):
            _log(f"NGX SR marker under {compat} is not a regular file: "
                 "ignoring it")
            return {}
        try:
            fd = os.open(NGX_MARKER, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=cfd)
            with os.fdopen(fd, "r") as handle:
                data = json.load(handle)
        except (OSError, ValueError):
            _log(f"NGX SR marker under {compat} is unreadable: ignoring it")
            return {}
    finally:
        os.close(cfd)
    if not isinstance(data, dict):
        _log(f"NGX SR marker under {compat} fails schema check: ignoring it")
        return {}
    files = data.get("files")
    if not isinstance(files, dict):
        _log(f"NGX SR marker under {compat} fails schema check: ignoring it")
        return {}
    for name, digest in files.items():
        if name not in NGX_MANAGED + NGX_LEGACY or not isinstance(digest, str) \
                or len(digest) != 64 \
                or any(c not in "0123456789abcdef" for c in digest.lower()):
            _log(f"NGX SR marker under {compat} fails schema check: "
                 "ignoring it")
            return {}
    # Legacy nvapi64.dll claims are dropped: only names still managed by
    # this version contribute ownership.
    return {name: digest for name, digest in files.items()
            if name in NGX_MANAGED}


def _ngx_lock(compat):
    """Non-blocking per-prefix lock fd, or None when another launch holds it."""
    try:
        fd = os.open(Path(compat) / NGX_LOCK, os.O_CREAT | os.O_RDWR, 0o644)
    except OSError:
        return None
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return None
    return fd


def _ngx_dirs(compat, create):
    """(compat_fd, system32_fd) pinning the prefix dirs, else (None, None).

    Every component below compat is opened O_NOFOLLOW|O_DIRECTORY (created
    like _ensure_prefix_nptunix does when create is set), so all later
    file operations run relative to the pinned directory and cannot be
    redirected by renaming or re-linking path components afterwards."""
    try:
        compat_fd = os.open(compat, os.O_RDONLY | os.O_DIRECTORY)
    except OSError:
        _log(f"compatdata {compat} is not a directory: passing through")
        return None, None
    node = compat_fd
    chain = []
    path = Path(compat)
    for name in ("pfx", "drive_c", "windows", "system32"):
        path = path / name
        child = None
        try:
            child = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                            dir_fd=node)
        except OSError:
            if create:
                try:
                    os.mkdir(name, 0o755, dir_fd=node)
                except OSError as error:
                    _log(f"cannot create {path}: {error}")
                else:
                    if name == "drive_c":
                        # Proton sets casefold right after creating drive_c;
                        # it only works on an empty directory, so do it now.
                        _set_casefold(path)
                    try:
                        child = os.open(name, os.O_RDONLY | os.O_DIRECTORY
                                        | os.O_NOFOLLOW, dir_fd=node)
                    except OSError as error:
                        _log(f"cannot open {path}: {error}")
        if child is None:
            break
        chain.append(child)
        node = child
    else:
        return compat_fd, node
    os.close(compat_fd)
    for fd in chain:
        os.close(fd)
    return None, None


def _ngx_temp(dirfd, data, mode):
    """Write data to a fresh hidden temp file inside dirfd; return its name."""
    for _ in range(10):
        name = f".ngx-{os.getpid()}-{os.urandom(4).hex()}.tmp"
        try:
            fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode,
                         dir_fd=dirfd)
        except FileExistsError:
            continue
        try:
            with os.fdopen(fd, "wb") as handle:
                handle.write(data)
            os.chmod(name, mode, dir_fd=dirfd)
        except BaseException:
            try:
                os.unlink(name, dir_fd=dirfd)
            except OSError:
                pass
            raise
        return name
    raise OSError("cannot create a staging file")


def _ngx_prefix_busy(compat):
    """True when a live process still names this prefix in WINEPREFIX.

    The NGX lock is released before exec, so an opt-out launch racing a
    just-started NGX-enabled game could delete the DLLs before it maps them.
    This check only narrows that window: a launch whose Wine processes
    have not been created yet is still uncovered.
    """
    prefix = os.path.join(os.path.realpath(compat), "pfx")
    try:
        pids = os.listdir("/proc")
    except OSError:
        return False
    for pid in pids:
        if not pid.isdigit():
            continue
        try:
            data = Path(f"/proc/{pid}/environ").read_bytes()
        except OSError:
            continue
        for item in data.split(b"\0"):
            if item.startswith(b"WINEPREFIX=") and \
                    os.path.realpath(os.fsdecode(item[11:])) == prefix:
                return True
    return False


def _ngx_cleanup(compat):
    """Remove this helper's own files from the prefix, then the marker.

    Only the fixed managed name is ever unlinked, and only when the
    (strictly validated) marker recorded them and the current digest still
    matches; a file the user replaced is kept and disowned. The marker is
    removed only when nothing is left pending: a busy prefix, a live Wine
    process or a failed unlink keeps the record for the next launch.
    """
    compat = Path(compat)
    if not os.path.lexists(compat / NGX_MARKER):
        return
    fd = _ngx_lock(compat)
    if fd is None:
        _log(f"NGX SR cleanup for {compat} skipped: prefix is busy")
        return
    try:
        if _ngx_prefix_busy(compat):
            _log(f"NGX SR cleanup for {compat} skipped: "
                 "a Wine process is still live")
            return
        owned = _ngx_marker(compat)
        cfd, sfd = _ngx_dirs(compat, create=False)
        if sfd is None:
            if not owned:
                try:
                    (compat / NGX_MARKER).unlink()
                except OSError:
                    pass
            return
        try:
            pending = False
            for name in NGX_MANAGED:
                digest = owned.get(name)
                if digest is None:
                    continue
                try:
                    info = os.stat(name, dir_fd=sfd, follow_symlinks=False)
                except FileNotFoundError:
                    continue
                except OSError as error:
                    pending = True
                    _log(f"cannot inspect managed {name} in {compat}: {error}")
                    continue
                if not stat.S_ISREG(info.st_mode):
                    continue
                try:
                    target = os.open(name, os.O_RDONLY | os.O_NOFOLLOW,
                                     dir_fd=sfd)
                    actual = _sha256_fd(target)
                except OSError as error:
                    pending = True
                    _log(f"cannot read managed {name} in {compat}: {error}")
                    continue
                if actual != digest:
                    continue
                try:
                    os.unlink(name, dir_fd=sfd)
                except OSError as error:
                    pending = True
                    _log(f"cannot remove managed {name} in {compat}: {error}")
            if not pending:
                try:
                    os.unlink(NGX_MARKER, dir_fd=cfd)
                except OSError:
                    pass
        finally:
            os.close(sfd)
            os.close(cfd)
    finally:
        os.close(fd)


def _ngx_rollback(sfd, state, done, temps, backups):
    """Undo a partially committed install, restoring the previous files."""
    for temp in temps.values():
        if temp is not None:
            try:
                os.unlink(temp, dir_fd=sfd)
            except OSError:
                pass
    for name in reversed(done):
        if state[name] == "empty":
            try:
                os.unlink(name, dir_fd=sfd)
            except OSError:
                pass
        else:
            try:
                os.replace(backups[name], name, src_dir_fd=sfd,
                           dst_dir_fd=sfd)
            except OSError:
                pass
            backups[name] = None
    for backup in backups.values():
        if backup is not None:
            try:
                os.unlink(backup, dir_fd=sfd)
            except OSError:
                pass


def _ngx_publish(compat, cfd, sfd, source, digest):
    """Commit the payload nvngx.dll and the marker as one transaction.

    The file is staged inside the pinned system32 first. An empty slot
    is published by link+unlink so a file appearing after the checks is
    never replaced; a managed file is kept as a hardlink backup until the
    marker commits, so a mid-update or marker failure restores the
    previous managed generation and no backup survives a return.
    """
    owned = _ngx_marker(compat)
    try:
        os.stat("_nvngx.dll", dir_fd=sfd, follow_symlinks=False)
    except FileNotFoundError:
        pass
    except OSError as error:
        _log(f"NGX SR refused: cannot inspect system32/_nvngx.dll: {error}")
        return False
    else:
        _log("NGX SR refused: system32/_nvngx.dll belongs to another "
             "provider; leaving it untouched")
        return False
    state = {}
    for name in NGX_MANAGED:
        try:
            info = os.stat(name, dir_fd=sfd, follow_symlinks=False)
        except FileNotFoundError:
            state[name] = "empty"
            continue
        except OSError as error:
            _log(f"NGX SR refused: cannot inspect system32/{name}: {error}")
            return False
        if not stat.S_ISREG(info.st_mode):
            _log(f"NGX SR refused: system32/{name} is not a regular file")
            return False
        claimed = owned.get(name)
        if claimed is None:
            _log(f"NGX SR refused: system32/{name} belongs to another "
                 "provider; leaving it untouched")
            return False
        try:
            target = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=sfd)
            actual = _sha256_fd(target)
        except OSError as error:
            _log(f"NGX SR refused: cannot read system32/{name}: {error}")
            return False
        if actual != claimed:
            _log(f"NGX SR refused: system32/{name} belongs to another "
                 "provider; leaving it untouched")
            return False
        state[name] = "managed"
    temps = {}
    backups = {}
    done = []
    try:
        temps["nvngx.dll"] = _ngx_temp(sfd, source.read_bytes(), 0o755)
        for name in NGX_MANAGED:
            if state[name] == "managed":
                backup = f".ngx-{name}.{os.urandom(4).hex()}.bak"
                os.link(name, backup, src_dir_fd=sfd, dst_dir_fd=sfd,
                        follow_symlinks=False)
                backups[name] = backup
        for name in NGX_MANAGED:
            if state[name] == "empty":
                # No-replace publish: link fails EEXIST if the slot filled.
                os.link(temps[name], name, src_dir_fd=sfd, dst_dir_fd=sfd,
                        follow_symlinks=False)
                os.unlink(temps[name], dir_fd=sfd)
            else:
                os.replace(temps[name], name, src_dir_fd=sfd, dst_dir_fd=sfd)
            temps[name] = None
            done.append(name)
        files = {"files": {"nvngx.dll": digest}}
        marker = _ngx_temp(cfd, json.dumps(files).encode(), 0o644)
        os.replace(marker, NGX_MARKER, src_dir_fd=cfd, dst_dir_fd=cfd)
    except BaseException as error:
        _ngx_rollback(sfd, state, done, temps, backups)
        _log(f"NGX SR install under {compat} failed: {error}")
        return False
    for backup in backups.values():
        try:
            os.unlink(backup, dir_fd=sfd)
        except OSError:
            pass
    return True


def _ngx_install(compat, env, root, tool):
    """Validate NGX eligibility and publish the managed nvngx.dll.

    nvapi64.dll is never written to the prefix: it is bound over the
    selected tool's own nvapi copy source so Proton's setup_prefix installs
    the payload copy. Only an empty nvngx slot or a file this helper
    installed earlier (marker digest match) is touched; a foreign
    nvngx/_nvngx is never overwritten, backed up or adopted. Returns the
    extra bwrap options for a candidate launch, or None when NGX
    cannot be enabled this launch.
    """
    if _ngx_overridden(env):
        _log("NGX SR refused: user WINEDLLOVERRIDES covers an NGX name")
        _ngx_cleanup(compat)
        return None
    if _ngx_nvapi_disabled(env):
        _log("NGX SR refused: user disabled Proton's NVAPI install")
        _ngx_cleanup(compat)
        return None
    sources = {}
    digests = {}
    for name in ("nvngx.dll", "nvapi64.dll"):
        source = Path(root) / "x86_64-windows" / name
        if not source.is_file() or graphics._pe_machine(source) != 0x8664:
            _log(f"NGX SR payload {name} is missing or not x86-64: "
                 "keeping base Neptune injection only")
            _ngx_cleanup(compat)
            return None
        sources[name] = source
        digests[name] = _sha256(source)
    dll_dir = Path(tool) / "files/lib/wine/nvapi/x86_64-windows"
    target = dll_dir / "nvapi64.dll"
    if not (dll_dir.is_dir() and target.is_file()):
        _log(f"NGX SR refused: {tool} has no nvapi x86-64 copy source")
        return None
    if Path(os.path.realpath(dll_dir)) != Path(os.path.abspath(dll_dir)):
        _log(f"unsafe NGX bind target under {tool}: passing through")
        return None
    target_real = Path(os.path.realpath(target))
    if target_real != Path(os.path.abspath(target)) and \
            not str(target_real).startswith(str(tool) + "/"):
        _log(f"unsafe NGX bind target under {tool}: passing through")
        return None
    compat = Path(compat)
    fd = _ngx_lock(compat)
    if fd is None:
        _log(f"NGX SR install for {compat} skipped: prefix is busy")
        return None
    try:
        cfd, sfd = _ngx_dirs(compat, create=True)
        if sfd is None:
            return None
        try:
            if not _ngx_publish(compat, cfd, sfd, sources["nvngx.dll"],
                                digests["nvngx.dll"]):
                return None
        finally:
            os.close(sfd)
            os.close(cfd)
    finally:
        os.close(fd)
    # Candidate only: the Windows side verifies the process-visible files
    # against these digests before activating NGX SR.
    return ["--ro-bind", str(sources["nvapi64.dll"]), str(target),
            "--setenv", "BRINEWELL_NGX_SR_CANDIDATE", "1",
            "--setenv", "BRINEWELL_NGX_CORE_SHA256", digests["nvngx.dll"],
            "--setenv", "BRINEWELL_NGX_NVAPI_SHA256", digests["nvapi64.dll"],
            "--unsetenv", "BRINEWELL_NGX_SR_ACTIVE"]


def _bwrap_setenvs(args, seen=None):
    """Return ordered assignments and whether every argfile was readable."""
    if seen is None:
        seen = set()
    assignments = []
    complete = True
    i = 0
    while i < len(args):
        if args[i] == "--setenv" and i + 2 < len(args):
            assignments.append((args[i + 1], args[i + 2]))
            i += 3
        elif args[i] == "--unsetenv" and i + 1 < len(args):
            assignments.append((args[i + 1], None))
            i += 2
        elif args[i] == "--args" and i + 1 < len(args) and args[i + 1].isdecimal():
            fd = int(args[i + 1])
            if fd in seen:
                complete = False
            else:
                seen.add(fd)
                try:
                    orig = os.lseek(fd, 0, os.SEEK_CUR)
                    try:
                        chunks = []
                        while True:
                            chunk = os.read(fd, 65536)
                            if not chunk:
                                break
                            chunks.append(chunk)
                    finally:
                        os.lseek(fd, orig, os.SEEK_SET)
                    words = [os.fsdecode(word) for word in b"".join(chunks).split(b"\0")]
                    nested, readable = _bwrap_setenvs(words, seen)
                    assignments.extend(nested)
                    complete = complete and readable
                except OSError:
                    complete = False
            i += 2
        else:
            i += 1
    return assignments, complete


def _injection(mode, cmd, env, bwrap_env=(), bwrap_complete=True):
    """Extra bwrap options for a recognized Proton game launch, else []."""
    info = graphics.proton_invocation(cmd, env)
    if not info:
        return []
    tool, verb_index = info
    hdr_bind = ["--ro-bind", str(HDR_DIR), "/run/brinewell/hdr"] if HDR_DIR.is_dir() else []
    compat = Path(env["STEAM_COMPAT_DATA_PATH"])
    if mode == "venus":
        _ngx_cleanup(compat)
        effective = dict(env)
        for key, value in bwrap_env:
            if value is None:
                effective.pop(key, None)
            else:
                effective[key] = value
        if effective.get("DISABLE_GAMESCOPE_WSI") == "1" or effective.get("BRINEWELL_HDR") == "0":
            return hdr_bind
        inject = hdr_bind + ["--setenv", "ENABLE_GAMESCOPE_WSI", "1"]
        if bwrap_complete and "DXVK_HDR" not in effective and not any(key == "DXVK_HDR" for key, _ in bwrap_env):
            inject += ["--setenv", "DXVK_HDR", "1"]
        return inject
    inject = _neptune_injection(mode, cmd, env, tool)
    if not inject:
        _ngx_cleanup(compat)
        return hdr_bind
    inject += hdr_bind
    candidate = None
    executable = cmd[verb_index + 1] if verb_index + 1 < len(cmd) else ""
    is_32bit = graphics._pe_machine(executable) == 0x14c
    if _ngx_requested(env) and _backend(mode) == "d3dmetal" and not is_32bit:
        candidate = _ngx_install(compat, env, _payload()[0], tool)
    else:
        _ngx_cleanup(compat)
    if candidate:
        at = inject.index("WINEDLLOVERRIDES") + 1
        inject[at] = f"{inject[at]};nvngx=n;nvapi64=n"
        inject += candidate
    else:
        # The wrapper owns the internal flags: a refused or disabled
        # launch must not inherit candidate or ACTIVE values set by an
        # outer environment.
        inject += ["--unsetenv", "BRINEWELL_NGX_SR_CANDIDATE",
                   "--unsetenv", "BRINEWELL_NGX_CORE_SHA256",
                   "--unsetenv", "BRINEWELL_NGX_NVAPI_SHA256",
                   "--unsetenv", "BRINEWELL_NGX_SR_ACTIVE"]
    return inject


def _neptune_injection(mode, cmd, env, tool):
    """Base Neptune bwrap options; [] keeps the launch untouched."""
    if graphics.graphics_overridden(env):
        return []
    fex = Path(cmd[0]).name == "FEXCompatTool"
    arch = graphics.select_arch(tool, env, fex)
    inject = []
    if mode not in ("neptune", "mullion"):
        return inject
    backend = _backend(mode)
    if arch is None or (backend == "d3dmetal" and arch != "x86_64"):
        return inject
    root, container_root, extra_binds = _payload()
    if root != PAYLOAD:
        _log(f"using dev Neptune payload {root}")
    bridge = root / "bridge" / arch
    # A missing payload is a broken install, not an unsafe launch.
    if not (bridge.joinpath("nptunix.dll").is_file()
            and bridge.joinpath("nptunix.so").is_file()):
        return inject
    providers = {"d3d11": "dxvk", "dxgi": "dxvk", "d3d12": "vkd3d-proton"}
    binds = []
    unsafe = False
    for name in GRAPHICS_DLLS:
        source = root / f"{arch}-windows" / f"{name}.dll"
        dll_dir = tool / "files/lib/wine" / providers[name] / f"{arch}-windows"
        target = dll_dir / f"{name}.dll"
        if not (source.is_file() and dll_dir.is_dir() and target.is_file()):
            return inject
        if Path(os.path.realpath(dll_dir)) != Path(os.path.abspath(dll_dir)):
            unsafe = True
            break
        target_real = Path(os.path.realpath(target))
        if target_real != Path(os.path.abspath(target)) and \
                not str(target_real).startswith(str(tool) + "/"):
            unsafe = True
            break
        binds += ["--ro-bind", str(source), str(target)]
    if unsafe:
        _log(f"unsafe bind target under {tool}: passing through")
        return []
    if not _ensure_prefix_nptunix(env["STEAM_COMPAT_DATA_PATH"], arch, root):
        return inject
    inject += extra_binds + binds
    dll_path = env.get("WINEDLLPATH")
    dll_path = f"{container_root}/bridge/{arch}" + (":" + dll_path if dll_path else "")
    inject += ["--setenv", "WINEDLLPATH", dll_path]
    overrides = env.get("WINEDLLOVERRIDES", "")
    native = ";".join(f"{name}=n" for name in GRAPHICS_DLLS)
    merged = ";".join(part for part in (overrides, native, "nptunix=b") if part)
    inject += ["--setenv", "WINEDLLOVERRIDES", merged]
    perf = graphics.npt_perf(env.get("NPT_PERF"))
    if perf is not None:
        inject += ["--setenv", "NPT_PERF", perf]
    inject += ["--setenv", "BRINEWELL_NEPTUNE_BACKEND", backend]
    return inject


def main(argv):
    delegate = _delegate()
    if delegate is None:
        print('brinewell: could not locate bubblewrap', file=sys.stderr)
        return 126
    extra = []
    if len(argv) > 4 and argv[0] == '--args' and argv[1].isdecimal():
        pv = next((i for i in range(2, len(argv))
                   if Path(argv[i]).name == 'pv-adverb'), None)
        if pv is not None and '--' in argv[pv + 1:]:
            command = argv[argv.index('--', pv + 1) + 1:]
            if graphics.proton_invocation(command, os.environ):
                mode = _mode()
                bwrap_env, complete = _bwrap_setenvs(argv[:pv]) if mode == 'venus' else ((), True)
                extra = _injection(mode, command, os.environ, bwrap_env, complete)
    args = argv[:2] + extra + argv[2:] if extra else argv
    os.execv(delegate, [delegate, *args])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
